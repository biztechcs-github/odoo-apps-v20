<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="report_invoice_1_external_layout">
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>
        <t t-call="biztech_report_template.report_header"/>
        <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
        <t t-call="biztech_report_template.template_footer"/>
    </template>

    <template id="report_header">
        <div class="header">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-3" style="height: 90px;">
                        <t t-if="o.company_id.invoice_logo_template">
                             <img t-att-src="image_data_uri(o.company_id.invoice_logo_template)" style="height: auto; max-height: 100%; max-width: 100%;"/>
                        </t>
                    </div>
                    <div class="col-3" style="padding-left: 10px;">
                        <t t-if="o.company_id.partner_id.email">
                            <span><strong>Email:</strong></span><br/>
                            <span t-attf-style="color: #{o.company_id and o.company_id.company_address_color_template or '#000000'};" t-field="o.company_id.email"/><br/>
                        </t>
                    </div>
                    <div class="col-3">
                        <t t-if="o.company_id.phone">
                            <span><strong>Phone:</strong></span><br/>
                            <span t-attf-style="color: #{o.company_id and o.company_id.company_address_color_template or '#000000'};" t-field="o.company_id.phone"/><br/>
                            <span t-attf-style="color: #{o.company_id and o.company_id.company_address_color_template or '#000000'};">Monday to Friday</span>
                        </t>
                    </div>
                    <div class="col-3">
                        <t t-if="o.company_id.partner_id.name">
                            <span><strong>Address:</strong></span><br/>
                            <section t-attf-style="color: #{o.company_id and o.company_id.company_color_template or '#000000'};" t-field="o.company_id.name"></section>
                            <section t-attf-style="color: #{o.company_id and o.company_id.company_address_color_template or '#000000'};" t-field="o.company_id.street"/>
                            <section t-attf-style="color: #{o.company_id and o.company_id.company_address_color_template or '#000000'};" t-field="o.company_id.city"/>
                            <section t-attf-style="color: #{o.company_id and o.company_id.company_address_color_template or '#000000'};" t-field="o.company_id.country_id"/>
                        </t>
                    </div>
                </div>
            </div>
            <div>
                <p t-attf-style="border-bottom:1px solid #{theme_color_template}; padding:5px;margin-bottom:0;"/>
            </div>
            <t t-call="biztech_report_template.template_watermark"/>
        </div>
    </template>

    <template id="info_invoice">
        <div class="container" style="width:100%;" t-att-style="'font-family:'+o.company_id.font_template_id.family+';font-size:'+str(o.company_id.font_size_template)+'px;'">
            
            <div class="row">
                <div align="left" class="col-4">
                <!-- <div style="width:50%;"> -->
                    <t t-call="biztech_report_template.invoice_templates_customer_details"/>
                    <p t-attf-style="border-top:1px solid #000000;width:50%">
                        <t t-call="biztech_report_template.invoice_templates_customer_shipping_details"/>
                    </p>
                </div>
                <div align="right" class="col-8">
                <!-- <div style="width:50%; "> -->
                    <table class="table table-borderless">
                        <tr t-attf-style="color: #{o.company_id and o.company_id.theme_color_template or '#000000'};font-size:50px;">
                            <td>
                                <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>
                                <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                                <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                                <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                                <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                                <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <table class="table table-borderless">
                                    <tbody>
                                        <tr class="tr-border-radius" t-attf-style="color: #{o.company_id and o.company_id.theme_text_color_template or '#000000'};font-weight:bold; };">
                                            <td t-if="o.move_type == 'out_invoice'" t-attf-style="background-color: #{o.company_id and o.company_id.theme_color_template or '#000000'};">
                                                <b>Invoice Date:</b><br/>
                                                <span t-out="o._get_invoice_date()"/>
                                            </td>
                                            <td t-if="o.name" t-attf-style="background-color: #{o.company_id and o.company_id.theme_color_template or '#000000'};">
                                                <b>Invoice No:</b><br/>
                                                <span t-field="o.name"/>
                                            </td>
                                            <td t-if="o.ref"  t-attf-style="background-color: #{o.company_id and o.company_id.theme_color_template or '#000000'};">
                                                <b>Reference:</b><br/>
                                                <span t-field="o.ref"/>
                                            </td>
                                            <td t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" t-attf-style="background-color: #{o.company_id and o.company_id.theme_color_template or '#000000'};">
                                                <b>Due Date:</b><br/>
                                                <span t-out="o._get_invoice_due_date()"/>
                                            </td>
                                            <td t-if="o.source_id" t-attf-style="background-color: #{o.company_id and o.company_id.theme_color_template or '#000000'};">
                                                <b>Source:</b><br/>
                                                <span t-out="o.source_id.name"/>
                                            </td>
                                            <td t-if="o.partner_id.ref" t-attf-style="background-color: #{o.company_id and o.company_id.theme_color_template or '#000000'};">
                                                <b>Customer code:</b><br/>
                                                <span t-out="o.partner_id.ref"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>                           
                        </tr>                        
                    </table>
                </div>
            </div>
           <!--  <div>
                <p t-attf-style="border-bottom:1px solid #{theme_color}; padding:5px"/>
            </div> -->
        </div>
    </template>

    <template id="report_main_invoice_1_template">
         <t t-call="biztech_report_template.report_invoice_1_external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)" />
            <div class="page">
                <t t-call="biztech_report_template.info_invoice"/>
                <t t-call="biztech_report_template.report_main_table"/>
                <t t-call="biztech_report_template.report_main_total"/>
                <t t-call="biztech_report_template.report_footer"/>
                <t t-call="biztech_report_template.signature"/>
            </div>
        </t>
    </template>

    <template id="report_main_invoice_1">
        <t t-call="web.html_container">
            <!-- <div class="page"> -->
                <t t-foreach="docs" t-as="o">
                    <t t-call="biztech_report_template.report_main_invoice_1_template" t-lang="lang"/>
                </t>
            <!-- </div> -->
        </t>
    </template>
</odoo>