<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id = "report_main_invoice_3_external_layout">
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>
        <t t-call="biztech_report_template.report_header3"/>
        <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
        <t t-call="biztech_report_template.template_footer"/>
    </template>

    <template id="report_header3">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <div class="header" t-att-style="'font-family:'+o.company_id.font_template_id.family+';font-size:'+str(o.company_id.font_size_template)+'px;'">
            <table class="table table-borderless" border="0" cellpadding="0" cellspacing="0" width="100%">
                <tbody>
                    <tr>
                        <td>
                            <center>
                                <table class="table table-borderless" border="0" cellpadding="0" cellspacing="0" style="margin:0;text-transform:uppercase;">
                                    <tr>
                                        <td align="left">
                                            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                                <tr>
                                                    <td align="left">
                                                        <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                                            <tr>
                                                                <td align="left">
                                                                    <t t-if="o.company_id.invoice_logo_template">
                                                                         <img t-att-src="o.company_id._get_report_logo_uri(colors['primary'])" style="height: auto; max-height: 100px; max-width: 100%;"/>
                                                                    </t>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                    <td align="right" style="width:50%;" valign="top">
                                                        <p t-attf-style="color: #{colors['primary_text']};background-color: #{colors['primary']}; text-align:center; text-transform:uppercase; width:50%;font-size:40px;padding:5px">
                                                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>
                                                            <span t-attf-style="font-size:35px;" t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                                                            <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                                                            <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                                                            <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                                                            <span t-if="o.move_type == 'in_invoice'">Vendor Bill
                                                            </span>
                                                        </p>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </center>
                        </td>
                    </tr>
                </tbody>
            </table>
            <t t-call='biztech_report_template.template_watermark'/>
        </div>
    </template>
    <template id="report_main_p1">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <div class="container-fluid">
            <div class="row" t-att-style="'font-family:'+o.company_id.font_template_id.family+';font-size:'+str(o.company_id.font_size_template)+'px;'" style="width: 100%;">

                <div class="col-12" t-attf-style="color: #{colors['primary_text']};font-weight:bold; background-color: #{colors['primary']};">
                    <div style="overflow:hidden;">
                        <div style="float:left; width:50%; padding:4px 12px; box-sizing:border-box;" t-if="o.move_type == 'out_invoice'">
                            <div><b>Invoice Date</b></div>
                            <div style="font-weight:normal;"><span t-out="o._get_invoice_date()"/></div>
                        </div>
                        <div style="float:left; width:50%; padding:4px 12px; box-sizing:border-box;" t-if="o.name">
                            <div><b>Invoice No</b></div>
                            <div style="font-weight:normal;"><span t-field="o.name"/></div>
                        </div>
                        <div style="float:left; width:50%; padding:4px 12px; box-sizing:border-box;" t-if="o.ref">
                            <div><b>Reference</b></div>
                            <div style="font-weight:normal;"><span t-field="o.ref"/></div>
                        </div>
                        <div style="float:left; width:50%; padding:4px 12px; box-sizing:border-box;" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'">
                            <div><b>Due Date</b></div>
                            <div style="font-weight:normal;"><span t-out="o._get_invoice_due_date()"/></div>
                        </div>
                        <div style="float:left; width:50%; padding:4px 12px; box-sizing:border-box;" t-if="o.source_id">
                            <div><b>Source</b></div>
                            <div style="font-weight:normal;"><span t-out="o.source_id.name"/></div>
                        </div>
                        <div style="float:left; width:50%; padding:4px 12px; box-sizing:border-box;" t-if="o.partner_id.ref">
                            <div><b>Customer code</b></div>
                            <div style="font-weight:normal;"><span t-out="o.partner_id.ref"/></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>
    
    <template id="report_main_p2">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
            <div class="container" t-att-style="'font-family:'+o.company_id.font_template_id.family+';font-size:'+str(o.company_id.font_size_template)+'px;'">
                <div>
                    <p t-attf-style="border-bottom:1px solid #{colors['primary']}; padding:5px"/>
                </div>
                <div class="row">
                    <div class="col-5">
                        <t t-call="biztech_report_template.invoice_templates_customer_details"/>
                    </div>
                    <div class="col-4">
                        <t t-call="biztech_report_template.invoice_templates_customer_shipping_details"/>
                    </div>
                    <div class="col-3" style="margin-top:1%;">
                        <t t-if="o.company_id.name">
                            <strong>Pay to:</strong><br/>
                            <t t-call="biztech_report_template.templates_company_details"/>
                        </t>
                    </div>

                </div>
                <div>
                    <p t-attf-style="border-bottom:1px solid #{colors['primary']}; padding:5px"/>
                </div>
            </div>
    </template>
    

    <template id="report_main_invoice_3_template">
         <t t-call="biztech_report_template.report_main_invoice_3_external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)" />
            <div class="page">
                <t t-call="biztech_report_template.report_main_p1"/>
                <t t-call="biztech_report_template.report_main_p2"/>
                <t t-call="biztech_report_template.report_main_table"/>
                <t t-call="biztech_report_template.report_main_total"/>
                <t t-call="biztech_report_template.report_footer"/>
                <t t-call="biztech_report_template.signature"/>
            </div> 
        </t>
    </template>

    <template id="report_main_invoice_3">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.html_container">
                <t t-call="biztech_report_template.report_main_invoice_3_template" t-lang="lang"/>
            </t>
        </t>
    </template>



</odoo>
