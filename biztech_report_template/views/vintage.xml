<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id = "report_main_invoice_3_external_layout">
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>
        <t t-call="biztech_report_template.report_header3"/>
        <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
        <t t-call="biztech_report_template.template_footer"/>
    </template>

    <template id="report_header3">
        <div class="header" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;'">
            <table class="table table-borderless" border="0" cellpadding="0" cellspacing="0" width="100%">
                <tbody>
                    <tr>
                        <td>
                            <center>
                                <table class="table table-borderless" border="0" cellpadding="0" cellspacing="0" style="margin:0;text-transform:uppercase;">
                                    <tr>
                                        <td align="left">
                                            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                                <tr>
                                                    <td align="left">
                                                        <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                                            <tr>
                                                                <td align="left">
                                                                    <t t-if="o.company_id.invoice_logo">
                                                                        <img t-att-src="image_data_uri(o.company_id.invoice_logo)" style="max-height: 80px;"/>
                                                                    </t>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                    <td align="right" style="width:80%;" valign="top">
                                                        <p t-attf-style="color: #{o.company_id and o.company_id.theme_text_color or '#000000'};background-color: #{o.company_id and o.company_id.theme_color or '#000000'}; text-align:center; text-transform:uppercase; width:50%;font-size:40px;padding:5px">
                                                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>
                                                            <span t-attf-style="font-size:35px;" t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                                                            <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                                                            <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                                                            <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                                                            <span t-if="o.move_type == 'in_invoice'">Vendor Bill
                                                            </span>
                                                        </p>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </center>
                        </td>
                    </tr>
                </tbody>
            </table>
            <t t-call='biztech_report_template.template_watermark'/>
        </div>
    </template>
    <template id="report_main_p1">
        <div class="container-fluid">
            <div class="row" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;'" style="width: 100%;">

                <div class="col-6" colspan="1" style="background-color:#C0C0C0; height:20px;border: 2px solid #C0C0C0;border-radius: 10px;padding: 5px;margin-right:0.5%;margin-top:1.5%"></div>
                <div class="col-6" t-attf-style="color: #{o.company_id and o.company_id.theme_text_color or '#000000'};font-weight:bold; background-color: #{o.company_id and o.company_id.theme_color or '#000000'};">
                    <table class="table table-borderless">
                        <tr t-attf-style="color: #{o.company_id and o.company_id.theme_text_color or '#000000'};font-weight:bold;background-color: #{o.company_id and o.company_id.theme_color or '#000000'};">
                            <td t-if="o.move_type == 'out_invoice'">
                                <b>Invoice Date:</b>
                                <span t-esc="o._get_invoice_date()"/>
                            </td>
                            <td t-if="o.name">
                                <b>Invoice No:</b>
                                <span t-field="o.name"/>
                            </td>
                            <td t-if="o.ref">
                                <b>Reference:</b>
                                <span t-field="o.ref"/>
                            </td>
                            <td t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'">
                                <b>Due Date:</b>
                                <span t-esc="o._get_invoice_due_date()"/>
                            </td>
                            
                            <td t-if="o.source_id">
                                <b>Source:</b>
                                <span t-esc="o.source_id.name"/>
                            </td>
                           
                            <td t-if="o.partner_id.ref">
                                <b>Customer code:</b>
                                <span t-esc="o.partner_id.ref"/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </template>
    
    <template id="report_main_p2">
            <div class="container" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;'">
                <div>
                    <p t-attf-style="border-bottom:1px solid #{theme_color}; padding:5px"/>
                </div>
                <div class="row">
                    <div class="col-5">
                        <t t-call="biztech_report_template.invoice_templates_customer_details"/>
                    </div>
                    <div class="col-4">
                        <t t-call="biztech_report_template.invoice_templates_customer_shipping_details"/>
                    </div>
                    <div class="col-3" style="margin-top:1%;">
                        <t t-if="o.company_id.name">
                            <strong>Pay to:</strong><br/>
                            <t t-call="biztech_report_template.templates_company_details"/>
                        </t>
                    </div>

                </div>
                <div>
                    <p t-attf-style="border-bottom:1px solid #{theme_color}; padding:5px"/>
                </div>
            </div>
    </template>
    

    <template id="report_main_invoice_3_template">
         <t t-call="biztech_report_template.report_main_invoice_3_external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)" />
            <div class="page">
                <t t-call="biztech_report_template.report_main_p1"/>
                <t t-call="biztech_report_template.report_main_p2"/>
                <t t-call="biztech_report_template.report_main_table"/>
                <t t-call="biztech_report_template.report_main_total"/>
                <t t-call="biztech_report_template.report_footer"/>
                <t t-call="biztech_report_template.signature"/>
            </div> 
        </t>
    </template>

    <template id="report_main_invoice_3">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.html_container">
                <t t-call="biztech_report_template.report_main_invoice_3_template" t-lang="lang"/>
            </t>
        </t>
    </template>



</odoo>
