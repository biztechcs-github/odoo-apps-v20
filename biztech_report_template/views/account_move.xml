<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_company_invoice_supplier_template" model="ir.ui.view">
        <field name="name">account.invoice.supplier.form.inherit</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="report_template_inv_id" options="{'no_create': True}" domain="[('report_name', 'ilike', '%main_invoice%')]"/>
                <field invisible="1" name="report_template_inv_id1" domain="[('report_name', 'ilike', '%main_invoice%')]"/>
            </xpath>
        </field>
    </record>
</odoo>