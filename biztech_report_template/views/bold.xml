<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <template id="report_main_invoice_4_external_layout">
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>
        <t t-call="biztech_report_template.report_header4"/>
        <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
            
        </div>
        <t t-call="biztech_report_template.template_footer"/>
    </template>

    <template id="report_header4">
        <div class="header" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;' ">
            <div class="container">
                <div class="row">
                    <div class="col-4">
                        <t t-if="o.company_id.invoice_logo">
                            <img t-att-src="image_data_uri(o.company_id.invoice_logo)"
                             alt="Company Logo"
                             style="height: auto; max-width: 100%;"/>
                        </t>
                    </div>
                    <div class="col-8">  
                        <p t-attf-style="font-size:50px;color: #{o.company_id and o.company_id.theme_color or '#000000'};text-align:right;">
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>
                            <span t-attf-style="font-size: 35px;" t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                            <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                            <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                            <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                        </p>
                    </div>
                </div>
            </div>
            <div >
                <p t-attf-style="border-bottom:1px solid #{theme_color}; padding:5px"/>
            </div>
            <t t-call='biztech_report_template.template_watermark'/>
        </div>
    </template>
    <template id="report_main_1">
        <div class="container-fluid">
            <div class="row">
                <div class="col-6">
                    <t t-call="biztech_report_template.invoice_templates_customer_details"/>
                    <div t-attf-style="border-top:1px solid #{theme_color or '#000000'};width:70%">
                        <t t-call="biztech_report_template.invoice_templates_customer_shipping_details"/>
                    </div>
                </div>

                <div class="col-6">
                  <table class="table table-borderless" border="0" cellpadding="0" cellspacing="0" t-attf-style="color: #{o.company_id and o.company_id.theme_text_color or '#000000'};font-weight:bold;margin-top:2%; background-color: #{o.company_id and o.company_id.theme_color or '#000000'};border-radius: 10px;">
                        <tr t-if="o._get_invoice_date()">
                            <td style="padding:5px 15px;">
                                <b>Invoice Date:</b>
                            </td>
                            <td style="text-align:right; padding:5px 15px;">
                                <span t-out="o._get_invoice_date()"/>
                            </td>
                        </tr>
                        <tr/>
                        <tr t-if="o.name">
                            <td style="padding:5px 15px;">
                                <b>Description:</b>
                            </td>
                            <td style="text-align:right;padding:5px 15px;">
                                <span t-field="o.name"/>
                            </td>
                        </tr>
                        <!-- <tr t-if="o.move_type">
                            <td style="padding:5px 15px;">
                                <b>
                                    <span t-if="o.move_type in ('out_invoice','out_refund')">SO:</span>
                                    <span t-if="o.move_type in ('in_invoice', 'in_refund')">PO:</span>
                                </b>
                            </td>
                            <td style="text-align:right;padding:5px 15px;">
                                <span t-field="o.invoice_origin"/>
                            </td>
                        </tr> -->
                        <tr t-if="o._get_origin_date(o.invoice_origin)">
                            <td style="padding:5px 15px;">
                                <b>Order Date:</b>
                            </td>
                            <td style="text-align:right; padding:5px 15px;">
                                <span t-out="o._get_origin_date(o.invoice_origin)"/>
                            </td>
                        </tr>
                        <tr t-if="o._get_invoice_due_date()">
                            <td style="padding:5px 15px;">
                                <b>Due Date:</b>
                            </td>
                            <td style="text-align:right; padding:5px 15px;">
                                <span t-out="o._get_invoice_due_date()"/>
                            </td>
                        </tr>
                        <tr t-if="o.ref">
                            <td style="padding:5px 15px;">
                                <b>Reference:</b>
                            </td>
                            <td style="text-align:right; padding:5px 15px;">
                                <span t-out="o.ref"/>
                            </td>
                        </tr>
                    </table>
                    <div>
                        <t t-if="o.company_id.name">
                            <strong t-attf-style="color: #{o.company_id and o.company_id.theme_color or '#000000'};">Pay to:</strong><br/>
                            <t t-call="biztech_report_template.templates_company_details"/>
                        </t>
                    </div>
                  
                    
                </div>
            </div>
            <div>
                <p t-attf-style="border-bottom:1px solid #{theme_color or '#000000'}; padding:5px"/>
            </div>
        </div>
    </template>


    
    <template id="report_main_invoice_4_template">
         <t t-call="biztech_report_template.report_main_invoice_4_external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)" />
            <div class="page">
                <t t-call="biztech_report_template.report_main_1"/>
                <t t-call="biztech_report_template.report_main_table"/>
                <t t-call="biztech_report_template.report_main_total"/>
                <t t-call='biztech_report_template.report_footer'/>
                <t t-call="biztech_report_template.signature"/>
            </div> 
        </t>
    </template>

    <template id="report_main_invoice_4">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.html_container">
                <t t-call="biztech_report_template.report_main_invoice_4_template" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>

