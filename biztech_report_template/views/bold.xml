<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <template id="report_main_invoice_4_external_layout">
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>
        <t t-call="biztech_report_template.report_header4"/>
        <div class="article o_report_layout_standard o_bold_remit" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="biztech_report_template.elegant_styles"/>
            <t t-out="0"/>
        </div>
        <t t-call="biztech_report_template.elegant_footer"/>
    </template>

    <template id="report_header4">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <div class="header o_bold_remit" t-att-style="'font-family:'+o.company_id.font_template_id.family+';font-size:'+str(o.company_id.font_size_template)+'px;' ">
            <t t-call="biztech_report_template.elegant_styles"/>
            <div class="o_bold_remit_band o_bold_remit_hband">
                <table class="re-hd" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td class="hlogo">
                            <t t-if="o.company_id.invoice_logo_template">
                                <img class="lg" t-att-src="o.company_id._get_report_logo_uri(colors['primary'])" alt="Company Logo"/>
                            </t>
                        </td>
                        <td>
                            <div class="dt">
                                <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>
                                <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                                <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                                <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                                <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                                <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                            </div>
                            <div class="no" t-if="o.name">
                                <span t-field="o.name"/>
                            </div>
                        </td>
                    </tr>
                </table>
                <table class="re-facts">
                    <tr>
                        <td t-if="o._get_invoice_date()">
                            <div class="lbl">Invoice Date</div>
                            <div class="fv"><span t-out="o._get_invoice_date()"/></div>
                        </td>
                        <td t-if="o._get_invoice_due_date()">
                            <div class="lbl">Due Date</div>
                            <div class="fv"><span t-out="o._get_invoice_due_date()"/></div>
                        </td>
                        <td t-if="o.ref">
                            <div class="lbl">Reference</div>
                            <div class="fv"><span t-out="o.ref"/></div>
                        </td>
                        <td t-if="o._get_origin_date(o.invoice_origin)">
                            <div class="lbl">Order Date</div>
                            <div class="fv"><span t-out="o._get_origin_date(o.invoice_origin)"/></div>
                        </td>
                        <td t-attf-style="background-color: #{colors['primary']}; border-color: #{colors['primary']}; color: #{colors['primary_text']};">
                            <div class="lbl" t-attf-style="color: #{colors['primary_text']};">Grand Total</div>
                            <div class="fv" style="font-weight:700; font-size:14px;"><span t-field="o.amount_total"/></div>
                        </td>
                    </tr>
                </table>
            </div>
            <t t-call='biztech_report_template.template_watermark'/>
        </div>
    </template>
    <template id="report_main_1">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <table class="parties" border="0" cellpadding="0" cellspacing="0">
            <tr>
                <td>
                    <t t-call="biztech_report_template.elegant_customer_details"/>
                </td>
                <td class="px">
                    <t t-if="o.company_id.name">
                        <p class="lbl" t-attf-style="background-color: #{colors['primary']}; color: #{colors['primary_text']};">Pay to</p>
                        <t t-call="biztech_report_template.templates_company_details"/>
                    </t>
                </td>
            </tr>
        </table>
    </template>

    <!-- Bold-only copies of the blocks whose look the design changes. The shared
         biztech_report_template.* versions stay untouched so Polished, Morden,
         Vintage, Corporate and Classic are unaffected. -->
    <template id="elegant_customer_details">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <p class="lbl" t-attf-style="background-color: #{colors['primary']}; color: #{colors['primary_text']};">
            <span t-if="o.partner_shipping_id == o.partner_id">Invoicing and Shipping Address</span>
            <span t-if="o.partner_shipping_id != o.partner_id">Invoicing Address</span>
        </p>
        <t t-if="o.partner_id">
            <t t-set="partner" t-value="o.partner_id"/>
            <t t-call="biztech_report_template.elegant_partner_block"/>
        </t>
        <t t-if="o.partner_shipping_id and o.partner_shipping_id != o.partner_id">
            <p class="lbl" t-attf-style="background-color: #{colors['primary']}; color: #{colors['primary_text']};">Shipping Address</p>
            <t t-set="partner" t-value="o.partner_shipping_id"/>
            <t t-call="biztech_report_template.elegant_partner_block"/>
        </t>
    </template>
    <template id="elegant_invoice_order_lines">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <table class="lines">
            <thead>
                <tr t-attf-style="background-color: #{colors['primary']}; color: #{colors['primary_text']};">
                    <th class="r k-sr">Sr.</th>
                    <th class="l k-image" t-if="o.company_id.add_product_image_template">Image</th>
                    <th class="l k-product">Item</th>
                    <th class="l k-desc" t-if="o.company_id.is_description_template">Description</th>
                    <th class="r k-price">Price</th>
                    <th class="r k-qty">Qty</th>
                    <th class="r k-disc">Discount(%)</th>
                    <th class="r k-tax">Taxes</th>
                    <th class="r k-amount">Total</th>
                </tr>
            </thead>
            <tbody t-attf-style="color: #{colors['text']};">
                <t t-as="l" t-foreach="o.invoice_line_ids">
                    <t t-if="l_odd">
                        <t t-set="ol_color" t-value="colors['even_party']"/>
                    </t>
                    <t t-if="l_even">
                        <t t-set="ol_color" t-value="colors['odd_party']"/>
                    </t>
                    <tr t-attf-style="background-color: #{ol_color or '#FFFFFF'};">
                        <td class="r k-sr"><t t-out="l_index+1"/></td>
                        <td class="l k-image" t-if="o.company_id.add_product_image_template">
                            <img class="thumb" t-if="l.product_id and l.product_id.image_1920" t-att-src="image_data_uri(l.product_id.image_1920)"/>
                        </td>
                        <td class="l k-product">
                            <div class="pbody">
                                <div class="pname">
                                    <span t-if="l.product_id" t-out="l.product_id.display_name"/>
                                    <span t-else="" t-field="l.name" t-options="{'widget': 'text'}"/>
                                </div>
                            </div>
                        </td>
                        <td class="l k-desc" t-if="o.company_id.is_description_template">
                            <span t-field='l.name'/>
                        </td>
                        <td class="r k-price"><t t-out="o.currency_id.symbol"/><span t-field="l.price_unit"/></td>
                        <td class="r k-qty"><span t-field="l.quantity"/></td>
                        <td class="r k-disc"><span t-field="l.discount"/></td>
                        <td class="r k-tax"><span t-field='l.tax_ids'/></td>
                        <td class="r k-amount"><span t-field="l.price_subtotal"/></td>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>
    <template id="elegant_invoice_totals">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <table class="tot">
            <t t-set="tax_totals" t-value="o.tax_totals"/>
            <t t-call="biztech_report_template.document_tax_totals_custom"/>
            <t t-if="print_with_payments">
                <t t-if="o.payment_state != 'invoicing_legacy'">
                    <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                    <t t-foreach="payments_vals" t-as="payment_vals">
                        <tr t-if="payment_vals['is_exchange'] == 0">
                            <td>
                                <i class="oe_form_field oe_payment_label">Paid on <t t-out="payment_vals['date']" t-options='{"widget": "date"}'/></i>
                            </td>
                            <td class="r">
                                <span t-out="payment_vals['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </t>
                    <tr class="o_due" t-attf-style="color: #{colors['primary_text']}; background-color: #{colors['primary']};" t-if="len(payments_vals) &gt; 0">
                        <td><strong>Amount Due</strong></td>
                        <td class="r">
                            <span t-field="o.amount_residual"/>
                        </td>
                    </tr>
                </t>
            </t>
        </table>
    </template>

    <template id="report_main_invoice_4_template">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
         <t t-call="biztech_report_template.report_main_invoice_4_external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)" />
            <div class="page" t-att-style="'font-family:'+o.company_id.font_template_id.family+';font-size:'+str(o.company_id.font_size_template)+'px;'">
                <t t-call="biztech_report_template.report_main_1"/>
                <t t-call="biztech_report_template.elegant_invoice_order_lines"/>
                <table class="bside" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td class="bl" t-attf-style="color: #{colors['text']};">
                            <t t-call='biztech_report_template.report_footer'/>
                        </td>
                        <td class="br">
                            <t t-call="biztech_report_template.elegant_invoice_totals"/>
                        </td>
                    </tr>
                </table>
                <div class="wline" t-attf-style="color: #{colors['text']};" t-if="o.company_id.add_amount_in_words_template == True">
                    <span class="lbl">Total in word:</span>
                    <span class="wv"><t t-out="o.amount_to_text"/></span>
                </div>
                <table class="fin" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td/>
                        <td class="fsig">
                            <t t-call="biztech_report_template.signature"/>
                        </td>
                    </tr>
                </table>
            </div> 
        </t>
    </template>

    <template id="report_main_invoice_4">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.html_container">
                <t t-call="biztech_report_template.report_main_invoice_4_template" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>
