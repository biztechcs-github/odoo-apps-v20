    <template id="template_watermark">
        <t t-if="o.company_id and o.company_id.is_show_watermark_template">
            <div class="watermark_template text-center" style="position:absolute; opacity:0.25; width:100%; height:auto; z-index:1000; -webkit-transform: rotate(-45deg); -moz-transform:rotate(-45deg); bottom:-600px; left:-100px;">
                <t t-if="o.company_id.watermark_template == 'logo'">
                    <span style="max-height: 500px; height:auto;" t-field="o.company_id.watermark_logo_template" t-options="{'widget':'image'}"/>
                    <!-- <img style="max-height: 500px; height:auto;" t-att-src="'data:image/png;base64,%s' %  to_text(o.company_id.watermark_logo)" t-if="o.company_id"/> -->
                </t>
                <t t-if="o.company_id.watermark_template != 'logo'">
                    <span t-att-style="'font-size:'+str(o.company_id.watermark_text_font_size_template)+'em; color:'+o.company_id.watermark_text_color_template">
                        <span t-field="o.company_id.watermark_text_template" t-if="o.company_id.watermark_template == 'text'"/>
                        <span t-field="o.state" t-if="o.company_id.watermark_template == 'status'"/>
                    </span>
                </t>
            </div>
        </t>
    </template>
    
    <template id="report_footer">
        <div t-att-style="'font-family:'+o.company_id.font_template_id.family+';font-size:'+str(o.company_id.font_size_template)+'px;'" t-attf-style="color: #{o.company_id and o.company_id.text_color_template or '#000000'};">
           <p t-if="o.company_id.is_show_payment_notes_template"> Please use the following communication for your payment : <b><span t-field="o.payment_reference"/></b></p>
            <p t-if="o.invoice_payment_term_id.note and o.company_id.is_show_payment_description_template == True">
            <strong><span t-field="o.invoice_payment_term_id.note"/></strong>
            </p>
            <t t-if="o.invoice_payment_term_id.display_on_invoice and payment_term_details">
                <div t-if='o.show_payment_term_details' id="total_payment_term_details_table" class="row">
                    <div t-attf-class="#{'col-7' if report_type != 'html' else 'col-sm-7 col-md-6'} mt-2 mb-2">
                        <table class="table" style="page-break-inside: avoid;">
                            <th class="border-black text-start">
                                Due Date
                            </th>
                            <th class="border-black text-end">
                                Amount Due
                            </th>
                            <th t-if="o.show_discount_details" class="border-black text-end">
                                Discount
                            </th>
                            <t t-foreach="payment_term_details" t-as="term">
                                <tr>
                                    <td t-out="term.get('date')" class="text-start"/>
                                    <td t-options='{"widget": "monetary", "display_currency": o.currency_id}' t-out="term.get('amount')" class="text-end"/>
                                    <td t-if="term.get('discount_date')" class="text-end">
                                        <span t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                              t-out="term.get('discount_amount_currency')"/> if paid before
                                        <span t-out="term.get('discount_date')"/>
                                    </td>
                                </tr>
                            </t>
                        </table>

                    </div>
                </div>
            </t>
            <div t-if="o.narration">    
                <strong>Terms and Condition:</strong>
                <span t-field="o.narration"/>
            </div>
        </div>
    </template>
