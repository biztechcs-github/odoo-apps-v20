                            <td class="tm_width_3 tm_primary_color tm_bold">Subtotal</td>
                            <td class="tm_width_3 tm_primary_color tm_bold tm_text_right" style="text-align:right"><t t-out="o.currency_id.symbol"/><span t-out="o.amount_untaxed"/></td>
                        </tr>


                        <tr>
                            <td class="tm_width_3 tm_primary_color tm_bold">Tax</td>
                            <td class="tm_width_3 tm_primary_color tm_bold tm_text_right" style="text-align:right"><t t-out="o.currency_id.symbol"/><span t-out="o.amount_tax_signed"/></td>
                        </tr>
            
                        <tr t-if="o.partner_id.vat" class="tm_gray_bg">
