    <!-- new added -->
     <template id="document_tax_totals_custom">
            <!--
                Generic template to display tax totals in pdf reports.
                Used by invoices, SO and PO.

                ARGUMENTS:
                - currency: The res.currency to use.
                - tax_totals: dict in the form generated by account.move's _get_tax_totals.
            -->
            <t t-set="currency" t-value="o.company_currency_id"/>
            <t t-set="same_tax_base" t-value="tax_totals['same_tax_base']"/>
            <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
                <tr class="o_subtotal">
                    <td>
                        <span t-out="subtotal['name']">Untaxed Amount</span>
                    </td>
                    <td class="text-end">
                        <t>
                            <span t-att-class="oe_subtotal_footer_separator"
                                  t-out="subtotal['base_amount_currency']"
                                  t-options='{"widget": "monetary", "display_currency": currency}'
                            >27.00</span>
                        </t> 
                    </td>
                </tr>

                <t t-foreach="subtotal['tax_groups']" t-as="tax_group">
                    <tr class="o_taxes">
                        <t t-if="same_tax_base or tax_group['display_base_amount_currency'] is None">
                            <td>
                                <span class="text-nowrap" t-out="tax_group['group_name']">Tax 15%</span>
                            </td>
                            <td class="text-end o_price_total">
                                <t>
                                    <span class="text-nowrap"
                                          t-out="tax_group['tax_amount_currency']"
                                          t-options='{"widget": "monetary", "display_currency": currency}'
                                    >1.05</span>
                                </t>
                            </td>
                        </t>
                        <t t-else="">
                            <td>
                                <span t-out="tax_group['group_name']">Tax 15%</span>
                                <span> on </span>
                                <span class="text-nowrap"
                                      t-out="tax_group['display_base_amount_currency']"
                                      t-options='{"widget": "monetary", "display_currency": currency}'
                                >27.00</span>
                            </td>
                            <td class="text-end o_price_total">
                                <span class="text-nowrap"
                                      t-out="tax_group['tax_amount_currency']"
                                      t-options='{"widget": "monetary", "display_currency": currency}'
                                >4.05</span>
                            </td>
                        </t>
                    </tr>
                </t>
            </t>

            <tr t-if="'cash_rounding_base_amount_currency' in tax_totals">
                <td>Rounding</td>
                <td class="text-end">
                    <span t-out="tax_totals['cash_rounding_base_amount_currency']"
                          t-options='{"widget": "monetary", "display_currency": currency}'
                    >0</span>
                </td>
            </tr>
            
            <!--Total amount with all taxes-->
            <tr class="tm_gray_bg" t-attf-style="color: #{o.company_id and o.company_id.theme_text_color_template or '#000000'};font-weight:bold; background-color: #{o.company_id and o.company_id.theme_color_template or '#000000'};">
                <td><strong>Total</strong></td>
                <td class="text-end">
                    <strong t-out="tax_totals['total_amount_currency']"
                            t-options='{"widget": "monetary", "display_currency": currency}'
                    >31.05</strong>
                </td>
            </tr>
        </template>
   
    <template id="tax_groups_totals_custom">
        <t t-foreach="tax_totals['groups_by_subtotal'][subtotal_to_show]" t-as="amount_by_group">
            <tr>
                <t t-if="tax_totals['display_tax_base']">
                    <td>
                        <span t-out="amount_by_group['tax_group_name']"/>
                        <span class="text-nowrap"> on
                            <t t-out="amount_by_group['formatted_tax_group_base_amount']"/>
                        </span>
                    </td>
                    <td class="text-end o_price_total">
                        <span class="text-nowrap" t-out="amount_by_group['formatted_tax_group_amount']"/>
                    </td>
                </t>
                <t t-else="">
                    <td><span class="text-nowrap" t-out="amount_by_group['tax_group_name']"/></td>
                    <td class="text-end o_price_total">
                        <span class="text-nowrap" t-out="amount_by_group['formatted_tax_group_amount']" />
                    </td>
                </t>
            </tr>
        </t>
    </template>
    <template id="report_main_total">
        <div class="fix" t-att-style="'font-family:'+o.company_id.font_template_id.family+';font-size:'+str(o.company_id.font_size_template)+'px;'">
