<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <template id="invoice_templates_customer_details">
        <t t-set="customer_color_template" t-value="o.company_id and o.company_id.customer_color_template"/>
        <t t-set="customer_address_color_template" t-value="o.company_id and o.company_id.customer_address_color_template"/>
        <p t-attf-style="text-transform:capitalize; color: #{o.company_id and o.company_id.theme_color_template or '#000000'}; font-weight:bold; margin:0; margin-bottom:5px; padding:5px 0px 0px 0px;">
            <strong t-if="o.partner_shipping_id == o.partner_id">Invoicing and shipping address:</strong>
            <strong t-if="o.partner_shipping_id != o.partner_id">Invoicing address:</strong>
        </p>
        <t t-if="o.partner_id">
            <span t-attf-style="text-transform:capitalize; padding:0px; margin:0; color: #{customer_color_template or '#000000'};">
                <t t-if="o.company_id and o.company_id.is_customer_bold_template">
                    <strong>
                        <span t-field="o.partner_id"/>
                    </strong>
                </t>
                <t t-if="not o.company_id.is_customer_bold_template">
                    <span t-field="o.partner_id"/>
                </t>
            </span>
            <p t-attf-style="color: #{customer_address_color_template or '#000000'};">
                <span t-out="o._get_street(o.partner_id)"/>
                <br/>
                <span t-out="o._get_address_details(o.partner_id)"/>
                <br/>
                <t t-if="o.partner_id.phone">
                    <strong>Mobile: </strong>
                    <span t-field="o.partner_id.phone"/>
                    <br/>
                </t>
                <t t-if="o.partner_id.email">
                    <strong>Email: </strong>
                    <span t-field="o.partner_id.email"/>
                    <br/>
                </t>
                <t t-if="o.partner_id.vat">
                    <strong>Vat: </strong>
                    <span t-field="o.partner_id.vat"/>
                </t>
            </p>
        </t>
    </template>
    <template id="invoice_templates_customer_shipping_details">
        <p t-attf-style="text-transform:capitalize; color: #{o.company_id and o.company_id.theme_color_template or '#000000'}; font-weight:bold; margin:0; margin-bottom:5px; padding:5px 0px 0px 0px; margin-top:3px;" t-if="o.partner_shipping_id != o.partner_id">
            <strong t-if="o.partner_shipping_id  and o.partner_shipping_id != o.partner_id">Shipping address:</strong>
        </p>
        <t t-if="o.partner_shipping_id and o.partner_shipping_id != o.partner_id">
            <span t-attf-style="text-transform:capitalize; padding:0px; margin:0; color: #{customer_color_template or '#000000'};">
                <t t-if="o.company_id and o.company_id.is_customer_bold_template">
                    <strong>
                        <span t-field="o.partner_shipping_id"/>
                    </strong>
                </t>
                <t t-if="not o.company_id.is_customer_bold_template">
                    <span t-field="o.partner_shipping_id"/>
                </t>
            </span>
            <p t-attf-style="color: #{customer_address_color_template or '#000000'};">
                <span t-out="o._get_street(o.partner_shipping_id)"/>
                <br/>
                <span t-out="o._get_address_details(o.partner_shipping_id)"/>
                <br/>
                <t t-if="o.partner_shipping_id.phone">
                    <strong>Mobile: </strong>
                    <span t-field="o.partner_shipping_id.phone"/>
                    <br/>
                </t>
                <t t-if="o.partner_shipping_id.email">
                    <strong>Email: </strong>
                    <span t-field="o.partner_shipping_id.email"/>
                    <br/>
                </t>
                <t t-if="o.partner_shipping_id.vat">
                    <strong>Vat: </strong>
                    <span t-field="o.partner_shipping_id.vat"/>
                </t>
            </p>
        </t>
    </template>
    <template id="templates_company_details">
        <t t-set="company_color_template" t-value="o.company_id and o.company_id.company_color_template"/>
        <t t-set="company_address_color_template" t-value="o.company_id and o.company_id.company_address_color_template"/>
        <span t-attf-style="text-transform:capitalize; padding:0px; margin:0; color: #{company_color_template or '#000000'};">
            <t t-if="o.company_id and o.company_id.is_company_bold_template">
                <strong>
                    <span t-field="o.company_id.partner_id"/>
                </strong>
            </t>
            <t t-if="not o.company_id.is_company_bold_template">
                <span t-field="o.company_id.partner_id"/>
            </t>
        </span>
        <div t-attf-style="color: #{company_address_color_template or '#000000'};">
            <span t-out="o._get_street(o.company_id.partner_id)"/>
            <br/>
            <span t-out="o._get_address_details(o.company_id.partner_id)"/>
            <br/>
            <t t-if="o.company_id.partner_id.phone">
                <strong>Mobile: </strong>
                <span t-field="o.company_id.partner_id.phone"/>
                <br/>
            </t>
            <t t-if="o.company_id.partner_id.email">
                <strong>Email: </strong>
                <span t-field="o.company_id.partner_id.email"/>
                <br/>
            </t>
        </div>
    </template>
       <template id="report_main_table">
        <div class="main" style="margin-top:1%;" t-att-style="'font-family:'+o.company_id.font_template_id.family+';font-size:'+str(o.company_id.font_size_template)+'px;'">
            
            <table class="table table-striped" style="margin-top:1%;border: 2px solid #ddd;border-radius: 8px;padding:8px;text-transform:capitalize;text-align:left" width="100%">
              <thead>
                <tr t-attf-style="color: #{o.company_id and o.company_id.theme_text_color_template or '#000000'};background-color: #{o.company_id and o.company_id.theme_color_template or '#000000'};">
                    <th style="border-bottom:2px solid #ddd">Sr.</th>
                    <t t-if="o.company_id.add_product_image_template">
                        <th style="border-bottom:2px solid #ddd">Image</th>
                    </t>
                    <th style="border-bottom:2px solid #ddd">Item</th>
                    <t t-if="o.company_id.is_description_template">
                        <th style="border-bottom:2px solid #ddd">Description</th>
                    </t>
                    <th style="border-bottom:2px solid #ddd">Price</th>
                    <th style="border-bottom:2px solid #ddd">Qty</th>
                    <th style="border-bottom:2px solid #ddd">Discount(%)</th>
                    <th style="border-bottom:2px solid #ddd">Taxes</th>
                    <th style="border-bottom:2px solid #ddd">Total</th>
                </tr>
              </thead>
              <tbody t-attf-style="color: #{o.company_id and o.company_id.text_color_template or '#000000'};">
                <t t-as="l" t-foreach="o.invoice_line_ids">
                    <tr>
                        <td><t t-out="l_index+1"/></td>
                        <t t-if="o.company_id.add_product_image_template">
                            <td class="text-right" t-att-style="'height:10%;width:10%;padding:5px 10px; border:0.5px solid #ccc !important; border-right:0px solid #ccc !important; '">
                                <img t-if="l.product_id and l.product_id.image_1920" t-att-src="image_data_uri(l.product_id.image_1920)" style="max-height: 4rem; max-width: 100%;"/>
                            </td>
                        </t>
                        <td><span t-field="l.product_id and l.product_id.name"/></td>
                        <t t-if="o.company_id.is_description_template">
                            <td>
                                <span t-field='l.name'/>
                            </td>
                        </t>
                        <td><t t-out="o.currency_id.symbol"/><span t-field="l.price_unit"/></td>
                        <td><span t-field="l.quantity"/></td>
                        <td><span t-field="l.discount"/></td>
                        <td><span t-field='l.tax_ids'/></td>
                        <td><span t-field="l.price_subtotal"/></td>
                    </tr>
                </t>
              </tbody>
            </table>
        </div>
    </template>

