<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id = "report_main_invoice_2_external_layout">
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>
        <t t-call="biztech_report_template.report_header2"/>
        <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
        <t t-call="biztech_report_template.template_footer"/>
    </template>

    <template id="report_header2">
        <div class="header clearfix" style="height:100px;" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;'">
            <div style="float:left">
                <t t-if="o.company_id.invoice_logo">
                     <img t-att-src="image_data_uri(o.company_id.invoice_logo)" style="height: 100px;"/>
                </t>
            </div>
            <div style="float:right; width:60%;">
                <div t-attf-style="color: #{o.company_id and o.company_id.theme_text_color or '#000000'};font-weight:bold;width:100%;">
                    <table class="table table-borderless" t-attf-style="color: #{o.company_id and o.company_id.theme_text_color or '#000000'};background-color: #{o.company_id and o.company_id.theme_color or '#000000'};font-weight:bold;text-align:center;font-size:35px; position: relative; margin-bottom: 0;">
                            <tr>
                                <td t-attf-style="width: 100%;position: relative;/* z-index: -1; */left: 0">
                                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">INVOICE</span>
                                    <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft INVOICE</span>
                                    <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled INVOICE</span>
                                    <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                                    <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                                    <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                                </td>
                                <td class="tm_shape_bg " t-attf-style="background-color: #{o.company_id and o.company_id.theme_color or '#000000'};position: absolute;height: 100%;width: 100%; -webkit-transform: skewX(35deg); transform: skewX(35deg); top: 0px;right: -100px; overflow: hidden; left: -77px; z-index: -1;"></td>
                            </tr>
                    </table>
                </div>
                <div class="row" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;width:100%; padding-top:20px;margin-left: 0;float:right;'">
                    <div class="col-12" style="padding:0;width:100%;">
                        <table class="table table-borderless" style="position: relative;">
                            <tr t-attf-style="color: #{o.company_id and o.company_id.theme_text_color or '#000000'};font-weight:bold; background-color: #{o.company_id and o.company_id.theme_color or '#000000'};">
                                <td t-if="o.move_type == 'out_invoice'">
                                    <b>Invoice Date:</b>
                                    <span t-out="o._get_invoice_date()"/>
                                </td>
                                <td t-if="o.name">
                                    <b>Invoice No:</b>
                                    <span t-field="o.name"/>
                                </td>
                                <td t-if="o.ref">
                                    <b>Reference:</b>
                                    <span t-field="o.ref"/>
                                </td>
                                
                                <td t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'">
                                    <b>Due Date:</b>
                                    <span t-out="o._get_invoice_due_date()"/>
                                </td>
                                
                                <td t-if="o.source_id">
                                    <b>Source:</b>
                                    <span t-out="o.source_id.name"/>
                                </td>
                               
                                <td t-if="o.partner_id.ref">
                                    <b>Customer code:</b>
                                    <span t-out="o.partner_id.ref"/>
                                </td>
                                <td t-if="o.invoice_origin">
                                    <b t-if="o.move_type in ('out_invoice','out_refund')">SO:</b>
                                    <b t-if="o.move_type in ('in_invoice', 'in_refund')">PO:</b>
                                    <span t-field="o.invoice_origin"/>


                                </td>
                                <td t-if="o._get_origin_date(o.invoice_origin)">
                                    
                                        <b>Order Date:</b>
                                        <span t-out="o._get_origin_date(o.invoice_origin)"/>
                                                            
                                </td>
                            </tr>
                            <tr class="tm_shape_bg " t-attf-style="background-color: #{o.company_id and o.company_id.theme_color or '#000000'};position: absolute;height: 100%;width: 89%;-webkit-transform: skewX(35deg);transform: skewX(35deg);top: 0px;right: -97px;overflow: hidden;left: -22px;z-index: -1;"></tr>
                        </table>
                    </div>
                </div>
            </div>
            <t t-call="biztech_report_template.template_watermark"/>
        </div>
    </template>
    <template id="report_main_h2">
            <div class="container" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;'">
                <div class="row">
                    <div class="col-5" style="margin-top:1.5%;margin-right:5px; margin-left:5px;">
                        <t t-call="biztech_report_template.invoice_templates_customer_details"/>
                    </div>
                    <div class="col-4" style="margin-top:1.5%;margin-right:5px; margin-left:5px;">
                        <t t-call="biztech_report_template.invoice_templates_customer_shipping_details"/>
                    </div>
                    <div class="col-3" style="margin-top:1.5%;margin-right:5px; margin-left:5px;">
                        <strong t-attf-style="color: #{o.company_id and o.company_id.theme_color or '#000000'};">Pay to:</strong><br/>
                        <t t-call="biztech_report_template.templates_company_details"/>
                    </div>
                </div>
                <div>
                    <p t-attf-style="border-bottom:1px solid #{theme_color};width:100%; padding:5px;"/>
                </div>
            </div>
    </template>

    <template id="report_main_invoice_2_template">
         <t t-call="biztech_report_template.report_main_invoice_2_external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)" />
            <div class="page">
                <t t-call="biztech_report_template.report_main_h2"/>
                <t t-call="biztech_report_template.report_main_table"/>
                <t t-call="biztech_report_template.report_main_total"/>
                <t t-call="biztech_report_template.report_footer"/>
                <t t-call="biztech_report_template.signature"/>
            </div> 
        </t>
    </template>


 <!-- Main Template -->
    <template id="report_main_invoice_2">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.html_container">
                <t t-call="biztech_report_template.report_main_invoice_2_template" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>