<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="base.main_company" model="res.company">
            <field file="biztech_report_template/static/src/img/company_image.png" name="invoice_logo_template" type="bytes"/>
        </record>
    </data>
    <data>
        <!-- Inherited Customer For add Reporting Field -->
        <record id="view_report_company_invoice_template" model="ir.ui.view">
            <field name="name">res.company.invoice.template.form.inherit</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="model">res.company</field>
            <field name="arch" type="xml">
                <xpath expr="//notebook//page[@name='general_info']" position="after">
                    <page string="Invoice Report Settings">
                        <group string="Default Template Settings">
                            <group>
                                <field domain="[('report_name', 'ilike', '%main_invoice%')]" name="report_template_inv_id" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <button class="oe_stat_button" icon="fa-pencil-square-o" name="action_view_report_extra_content_button" type="object">
                                    <span>Report Extra Content</span>
                                </button>
                            </group>
                        </group>
                        <group string="Template Configuration">
                            <group>
                                <field name="invoice_logo_template" widget="image"  class="responsive-img"
                                    style="text-align: center; max-width: 200px; width: 100%; height: auto; margin: auto;"/>
                                <field name="invoice_logo_color_mode_template"/>
                                <field invisible="invoice_logo_color_mode_template != 'custom'" required="invoice_logo_color_mode_template == 'custom'" name="invoice_logo_color_template" placeholder=" like #a24689" widget="color"/>
                                <field name="standard_template_report"/>
                            </group>
                            <group name="watermark" string="Watermark">
                                <field name="is_show_watermark_template"/>
                                <field name="watermark_template" invisible="not is_show_watermark_template"/>
                                <field invisible = "not is_show_watermark_template or watermark_template != 'logo'" name="watermark_logo_template" widget="image"  class="responsive-img"
                                    style="text-align: center; max-width: 200px; width: 100%; height: auto; margin: auto;"/>
                                <field invisible="not is_show_watermark_template or watermark_template != 'text'" required = "watermark_template == 'text'" name="watermark_text_template"/>
                                <field invisible="not is_show_watermark_template or watermark_template == 'logo'" required = "watermark_template != 'logo'" name="watermark_text_color_template" placeholder="like #2b4e99" widget="color"/>
                                <field invisible="not is_show_watermark_template or watermark_template == 'logo'" required = "watermark_template != 'logo'" name="watermark_text_font_size_template"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="company_color_template" placeholder=" like #b30000" widget="color"/>
                                <field name="company_address_color_template" placeholder=" like #b30010" widget="color"/>
                                <field name="is_company_bold_t"/>
                            </group>
                            <group>
                                <field name="customer_color_template" placeholder=" like #2763a1" widget="color"/>
                                <field name="customer_address_color_template" placeholder=" like #2763c1" widget="color"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="theme_color_template" placeholder=" like #d4d2d2" widget="color"/>
                                <field name="background_color_template" placeholder=" like #454542" widget="color"/>
                                <field name="theme_text_color_template" placeholder=" like #2d3538" widget="color"/>
                                <field name="text_color_template" placeholder=" like #5bb3d2" widget="color"/>
                            </group>
                            <group>
                                <field name="is_description_template"/>
                                <field name="add_product_image_template"/>
                                <field name="is_show_payment_notes_template"/>
                                <field name="is_show_payment_description_template"/>
                                <field name="add_amount_in_words_template" />
                            </group>
                        </group>
                        <group>
                            <group name="font" string="Report Font">
                                <label for="font_template_id" string="Report Font"/>
                                <div>
                                    <field class="oe_inline" name="font_template_id" required="True" widget="selection"/>
                                    <button class="oe_link" name="act_discover_fonts" string="(Reload Fonts)" title="Please click here if you want to get all the fonts of your system. After click please reload the page." type="object"/>
                                </div>
                                <field name="font_size_template"/>
                            </group>
                            <group string="Report Footer">
                                <field name="report_footer_selection_template"/>
                            </group>
                        </group>
                        <group string="Signature">
                                <field name="is_show_signature_template"/>
                                <field invisible="is_show_signature_template == False" required = "is_show_signature_template == True" name="signature_template" widget="image" class="responsive-img"
                                    style="text-align: center; max-width: 200px; width: 100%; height: auto; margin: auto;"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>