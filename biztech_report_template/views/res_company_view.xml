<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="base.main_company" model="res.company">
            <field file="biztech_report_template/static/src/img/company_image.png" name="invoice_logo" type="base64"/>
        </record>
    </data>
    <data>
        <!-- Inherited Customer For add Reporting Field -->
        <record id="view_report_company_invoice_template" model="ir.ui.view">
            <field name="name">res.company.invoice.template.form.inherit</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="model">res.company</field>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Default Report Settings">
                        <group string="Default Template Settings">
                            <group>
                                <field required= "True" domain="[('report_name', 'ilike', '%main_invoice%')]" name="report_template_inv_id" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <button class="oe_stat_button" icon="fa-pencil-square-o" name="action_view_report_extra_content" type="object">
                                    <span>Report Extra Content</span>
                                </button>
                            </group>
                        </group>
                        <group string="Template Configuration">
                            <group>
                                <field class="oe_avatar" name="invoice_logo" widget="image"/>
                                <field name="standard_template"/>
                            </group>
                            <group name="watermark" string="Watermark">
                                <field name="is_show_watermark"/>
                                <field name="watermark" invisible="not is_show_watermark"/>
                                <field invisible = "not is_show_watermark or watermark != 'logo'" class="oe_avatar" name="watermark_logo" widget="image"/>
                                <field invisible="not is_show_watermark or watermark != 'text'" required = "watermark == 'text'" name="watermark_text"/>
                                <field invisible="not is_show_watermark or watermark == 'logo'" required = "watermark != 'logo'" name="watermark_text_color" placeholder="like #2b4e99" widget="color"/>
                                <field invisible="not is_show_watermark or watermark == 'logo'" required = "watermark != 'logo'" name="watermark_text_font_size"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="company_color" placeholder=" like #b30000" widget="color"/>
                                <field name="company_address_color" placeholder=" like #b30010" widget="color"/>
                                <field name="is_company_bold"/>
                            </group>
                            <group>
                                <field name="customer_color" placeholder=" like #2763a1" widget="color"/>
                                <field name="customer_address_color" placeholder=" like #2763c1" widget="color"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="theme_color" placeholder=" like #d4d2d2" widget="color"/>
                                <field name="background_color" placeholder=" like #454542" widget="color"/>
                                <field name="theme_text_color" placeholder=" like #2d3538" widget="color"/>
                                <field name="text_color" placeholder=" like #5bb3d2" widget="color"/>
                            </group>
                            <group>
                                <field name="is_description"/>
                                <field name="add_product_image"/>
                                <field name="is_show_payment_notes"/>
                                <field name="is_show_payment_description"/>
                                <field name="add_amount_in_words" />
                            </group>
                        </group>
                        <group>
                            <group name="font" string="Report Font">
                                <label for="font_id" string="Report Font"/>
                                <div>
                                    <field class="oe_inline" name="font_id" required="True" widget="selection"/>
                                    <button class="oe_link" name="act_discover_fonts" string="(Reload Fonts)" title="Please click here if you want to get all the fonts of your system. After click please reload the page." type="object"/>
                                </div>
                                <field name="font_size"/>
                            </group>
                            <group string="Report Footer">
                                <field name="report_footer_selection"/>
                            </group>
                        </group>
                        <group col="4" string="Signature">
                            <field name="is_show_signature"/>
                            <field invisible="is_show_signature == False" required = "is_show_signature == True" class="oe_avatar" name="signature" widget="image"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>