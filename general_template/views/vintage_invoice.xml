<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--template id="template_invoice_style" inherit_id="web.report_assets_common">
        <xpath expr=".">
            <link href="/general_template/static/src/css/template.css" rel="stylesheet"/>
        </xpath>
    </template-->
    <template id="template_external_layout">
        <!-- Multicompany -->
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>
        <t t-call="general_template.template_header"/>
        <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
        <t t-call="general_template.template_footer"/>
    </template>
    <template id="template_header">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <div class="header" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;'">
            <table class="table table-borderless" border="0" cellpadding="0" cellspacing="0" width="100%">
                <tbody>
                    <tr>
                        <td style="padding-left: 0; padding-right: 0;">
                            <center>
                                <table class="table table-borderless" border="0" cellpadding="0" cellspacing="0" width="100%">
                                    <tr>
                                        <td align="left" colspan="2" valign="top" style="padding-left: 0; padding-right: 0;">
                                            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                                <tr>
                                                    <td align="left" valign="middle">
                                                        <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                                            <tr>
                                                                <td align="left" valign="middle">
                                                                    <t t-if="o.company_id.invoice_logo">
                                                                        <img t-att-src="o.company_id._get_report_logo_uri(colors['primary'])" style="height: auto; max-height: 100px; max-width: 100%;"/>
                                                                    </t>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                    <td align="right" rowspan="3" style="width:60%;">
                                                        <p t-attf-style="color: #{colors['primary_text']};background-color: #{colors['primary']}; text-align:center; text-transform:uppercase; padding:5px 0px; width:60%;font-size:35px">
                                                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>
                                                            <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                                                            <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                                                            <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                                                            <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                                                            <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                                                        </p>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </center>
                        </td>
                    </tr>
                </tbody>
            </table>
            <t t-call="general_template.template_watermark"/>
        </div>
    </template>
    <template id="report_invoice_template_main">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <t t-call="general_template.template_external_layout">
            <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
            <div class="page" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;'">
                <div class="oe_structure"/>
                <!-- <t t-call="general_template.template_watermark"/> -->
                <div border="0" cellpadding="0" cellspacing="0" width="100%">
                    <div class="container-fluid">
                        
                        <div class="row" valign="top" >
                            <div class="col-12" t-attf-style="color: #{colors['primary_text']};font-weight:bold; background-color: #{colors['primary']};">
                                <div style="overflow:hidden;">
                                    <div style="float:left; width:50%; padding:4px 12px; box-sizing:border-box;" t-if="o.move_type == 'out_invoice'">
                                        <div><b>Invoice Date</b></div>
                                        <div style="font-weight:normal;"><span t-out="o._get_invoice_date()"/></div>
                                    </div>
                                    <div style="float:left; width:50%; padding:4px 12px; box-sizing:border-box;" t-if="o.payment_reference">
                                        <div><b>Invoice No</b></div>
                                        <div style="font-weight:normal;"><span t-field="o.payment_reference"/></div>
                                    </div>
                                    <div style="float:left; width:50%; padding:4px 12px; box-sizing:border-box;" t-if="o.ref">
                                        <div><b>Reference</b></div>
                                        <div style="font-weight:normal;"><span t-field="o.ref"/></div>
                                    </div>
                                    <div style="float:left; width:50%; padding:4px 12px; box-sizing:border-box;" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'">
                                        <div><b>Due Date</b></div>
                                        <div style="font-weight:normal;"><span t-out="o._get_invoice_due_date()"/></div>
                                    </div>
                                    <div style="float:left; width:50%; padding:4px 12px; box-sizing:border-box;" t-if="o.source_id">
                                        <div><b>Source</b></div>
                                        <div style="font-weight:normal;"><span t-out="o.source_id.name"/></div>
                                    </div>
                                    <div style="float:left; width:50%; padding:4px 12px; box-sizing:border-box;" t-if="o.partner_id.ref">
                                        <div><b>Customer code</b></div>
                                        <div style="font-weight:normal;"><span t-out="o.partner_id.ref"/></div>
                                    </div>
                                    <div style="float:left; width:50%; padding:4px 12px; box-sizing:border-box;" t-if="o.invoice_origin">
                                        <div><b><t t-if="o.move_type in ('out_invoice','out_refund')">SO</t><t t-if="o.move_type in ('in_invoice', 'in_refund')">PO</t></b></div>
                                        <div style="font-weight:normal;"><span t-field="o.invoice_origin"/></div>
                                    </div>
                                    <div style="float:left; width:50%; padding:4px 12px; box-sizing:border-box;" t-if="o._get_origin_date(o.invoice_origin)">
                                        <div><b>Order Date</b></div>
                                        <div style="font-weight:normal;"><span t-out="o._get_origin_date(o.invoice_origin)"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div>
                            <p t-attf-style="border-bottom:1px solid #{colors['primary']}; padding:5px"/>
                        </div>
                        <div class="row">
                            
                            
                            <div class="col-5">
                                <t t-call="general_template.invoice_templates_customer_details"/>
                            </div>
                            <div class="col-4">
                                <t t-call="general_template.invoice_templates_customer_shipping_details"/>
                            </div>
                            <div class="col-3">
                                <span t-attf-style="color: #{colors['primary']}; font-weight:bold;">Pay to:</span><br/>
                                <t t-call="general_template.templates_company_details"/>
                            </div>
                        </div>
                        <div>
                            <p t-attf-style="border-bottom:1px solid #{colors['primary']}; padding:5px"/>
                        </div>
                        <div style="padding:5px 0px 0 0; font-weight:bold; width:100%;" >
                            <t t-call="general_template.report_invoice_order_lines"/>
                        </div>
                        <div>
                            <t t-call="general_template.invoice_subtotal_tem" />
                        </div>
                        <div t-attf-style="border-bottom:1px solid #{'#959595'}; padding:0px; text-align: right;">
                            <t t-call="general_template.template_total_amount_word"/>
                        </div>
                        <div t-if="not o._compute_payments_widget_reconciled_info()">
                            <p t-att-style="'font-weight:bold; margin-bottom:0; text-transform:capitalize; margin-top:8px; color: %s;' % (colors['text'])">
                            Payment Status: 
                                <span t-out="dict(o._fields['payment_state']._description_selection(o.env)).get(o.payment_state)"/>
                            </p>
                        </div>
                        <div class="pull-left" style="color: #{colors['text']}; padding-top:5px; ">
                            <t t-call="general_template.report_invoice_notes"/>
                        </div>
                        <div align="right"  style="color: #{colors['text']};">
                            <t t-call="general_template.report_invoice_signature"/>
                            <t t-call="general_template.report_invoice_barcode"/>
                        </div>
                        <div class="oe_structure"/>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="report_invoice_template_custom">
        <t t-call="web.html_container">
            <t t-as="o" t-foreach="docs">
                <t t-set="o" t-value="o.with_context(lang=lang)" />
                <t t-call="general_template.report_invoice_template_main" t-lang="lang"/>
            </t>
        </t>
    </template>
    <template id="report_invoice_template_main_duplicate" inherit_id="general_template.report_invoice_template_main" primary="True">
       <!--  <xpath expr="//div[@t-if='not o._compute_payments_widget_reconciled_info()'] " position="before">
            <t t-call="general_template.report_invoice_payment_move_line"/>
        </xpath> -->
    </template>
    <!-- Inherit rather than redefine account.report_invoice: the core record keeps its own
         arch, so uninstalling this module restores the standard design
         instead of leaving an orphaned template behind. -->
    <template id="report_invoice_dispatch" inherit_id="account.report_invoice">
        <xpath expr="." position="replace">
            <t t-call="web.html_container">
                <t t-as="o" t-foreach="docs">
                    <t t-set="lang" t-value="o.partner_id.lang"/>
                    <!-- general_template and biztech_report_template both define this template id,
                         so which copy survives depends on module load order. Resolve the selection
                         from whichever module's field is installed, record before partner before
                         company, so the chosen design prints either way. -->
                    <t t-set="has_biz" t-value="'report_template_inv_id' in o._fields"/>
                    <t t-set="has_gen" t-value="'report_template_id' in o._fields"/>
                    <t t-set="sel_rec" t-value="has_biz and o.report_template_inv_id or has_gen and o.report_template_id"/>
                    <t t-set="sel_partner" t-value="has_biz and o.partner_id.report_template_inv_id or has_gen and o.partner_id.report_template_id"/>
                    <t t-set="sel_company" t-value="has_biz and o.company_id.report_template_inv_id or has_gen and o.company_id.report_template_id"/>
                    <t t-set="sel" t-value="sel_rec or sel_partner or sel_company"/>
                    <t t-set="r_name" t-value="sel and sel.report_name"/>
                    <t t-set="known" t-value="r_name and (r_name.startswith('general_template.report_invoice_template_custom') or r_name.startswith('biztech_report_template.report_main_invoice_'))"/>
                    <t t-if="known">
                        <t t-call="general_template.report_invoice_template_main" t-if="r_name == 'general_template.report_invoice_template_custom'" t-lang="lang"/>
                        <t t-call="general_template.report_invoice_advanced_main" t-if="r_name == 'general_template.report_invoice_template_custom_advanced'" t-lang="lang"/>
                        <t t-call="general_template.report_invoice_elegant_main" t-if="r_name == 'general_template.report_invoice_template_custom_elegant'" t-lang="lang"/>
                        <t t-call="general_template.report_invoice_exclusive_main" t-if="r_name == 'general_template.report_invoice_template_custom_exclusive'" t-lang="lang"/>
                        <t t-call="general_template.report_invoice_creative_main" t-if="r_name == 'general_template.report_invoice_template_custom_creative'" t-lang="lang"/>
                        <t t-call="general_template.report_invoice_incredible_main" t-if="r_name == 'general_template.report_invoice_template_custom_incredible'" t-lang="lang"/>
                        <t t-call="biztech_report_template.report_main_invoice_1_template" t-if="r_name == 'biztech_report_template.report_main_invoice_1'" t-lang="lang"/>
                        <t t-call="biztech_report_template.report_main_invoice_2_template" t-if="r_name == 'biztech_report_template.report_main_invoice_2'" t-lang="lang"/>
                        <t t-call="biztech_report_template.report_main_invoice_3_template" t-if="r_name == 'biztech_report_template.report_main_invoice_3'" t-lang="lang"/>
                        <t t-call="biztech_report_template.report_main_invoice_4_template" t-if="r_name == 'biztech_report_template.report_main_invoice_4'" t-lang="lang"/>
                        <t t-call="biztech_report_template.report_main_invoice_5_template" t-if="r_name == 'biztech_report_template.report_main_invoice_5'" t-lang="lang"/>
                        <t t-call="biztech_report_template.report_main_invoice_6_template" t-if="r_name == 'biztech_report_template.report_main_invoice_6'" t-lang="lang"/>
                    </t>
                    <t t-else=''>
                        <t t-if="o._get_name_invoice_report() == 'account.report_invoice_document'"
                           t-call="account.report_invoice_document"
                           t-lang="lang"/>
                    </t>
                </t>
            </t>
        </xpath>
    </template>
    <!-- Inherit rather than redefine account.report_invoice_with_payments: the core record keeps its own
         arch, so uninstalling this module restores the standard design
         instead of leaving an orphaned template behind. -->
    <template id="report_invoice_with_payments_dispatch" inherit_id="account.report_invoice_with_payments">
        <xpath expr="." position="replace">
            <t t-call="web.html_container">
                <t t-as="o" t-foreach="docs">
                    <t t-set="lang" t-value="o.partner_id.lang"/>
                    <t t-set="print_with_payments" t-value="True"/>
                    <!-- general_template and biztech_report_template both define this template id,
                         so which copy survives depends on module load order. Resolve the selection
                         from whichever module's field is installed, record before partner before
                         company, so the chosen design prints either way. -->
                    <t t-set="has_biz" t-value="'report_template_inv_id' in o._fields"/>
                    <t t-set="has_gen" t-value="'report_template_id' in o._fields"/>
                    <t t-set="sel_rec" t-value="has_biz and o.report_template_inv_id or has_gen and o.report_template_id"/>
                    <t t-set="sel_partner" t-value="has_biz and o.partner_id.report_template_inv_id or has_gen and o.partner_id.report_template_id"/>
                    <t t-set="sel_company" t-value="has_biz and o.company_id.report_template_inv_id or has_gen and o.company_id.report_template_id"/>
                    <t t-set="sel" t-value="sel_rec or sel_partner or sel_company"/>
                    <t t-set="r_name" t-value="sel and sel.report_name"/>
                    <t t-set="known" t-value="r_name and (r_name.startswith('general_template.report_invoice_template_custom') or r_name.startswith('biztech_report_template.report_main_invoice_'))"/>
                    <t t-if="known">
                        <t t-call="general_template.report_invoice_template_main_duplicate" t-if="r_name == 'general_template.report_invoice_template_custom'" t-lang="lang"/>
                        <t t-call="general_template.report_invoice_advanced_main_duplicate" t-if="r_name == 'general_template.report_invoice_template_custom_advanced'" t-lang="lang"/>
                        <t t-call="general_template.report_invoice_elegant_main_duplicate" t-if="r_name == 'general_template.report_invoice_template_custom_elegant'" t-lang="lang"/>
                        <t t-call="general_template.report_invoice_exclusive_main_duplicate" t-if="r_name == 'general_template.report_invoice_template_custom_exclusive'" t-lang="lang"/>
                        <t t-call="general_template.report_invoice_creative_main_duplicate" t-if="r_name == 'general_template.report_invoice_template_custom_creative'" t-lang="lang"/>
                        <t t-call="general_template.report_invoice_incredible_main_duplicate" t-if="r_name == 'general_template.report_invoice_template_custom_incredible'" t-lang="lang"/>
                        <t t-call="biztech_report_template.report_main_invoice_1_template" t-if="r_name == 'biztech_report_template.report_main_invoice_1'" t-lang="lang"/>
                        <t t-call="biztech_report_template.report_main_invoice_2_template" t-if="r_name == 'biztech_report_template.report_main_invoice_2'" t-lang="lang"/>
                        <t t-call="biztech_report_template.report_main_invoice_3_template" t-if="r_name == 'biztech_report_template.report_main_invoice_3'" t-lang="lang"/>
                        <t t-call="biztech_report_template.report_main_invoice_4_template" t-if="r_name == 'biztech_report_template.report_main_invoice_4'" t-lang="lang"/>
                        <t t-call="biztech_report_template.report_main_invoice_5_template" t-if="r_name == 'biztech_report_template.report_main_invoice_5'" t-lang="lang"/>
                        <t t-call="biztech_report_template.report_main_invoice_6_template" t-if="r_name == 'biztech_report_template.report_main_invoice_6'" t-lang="lang"/>
                    </t>
                    <t t-else=''>
                        <t t-if="o._get_name_invoice_report() == 'account.report_invoice_document'"
                           t-call="account.report_invoice_document"
                           t-lang="lang"/>
                    </t>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
