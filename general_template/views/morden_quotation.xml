<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="quotation_template_external_layout">
        <!-- Multicompany -->
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>
        <t t-call="general_template.quotation_template_header"/>
        <div class="article o_report_layout_standard o_modern_duet" t-att-data-oe-id="o and o.id" t-att-data-oe-model="o and o._name" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="general_template.creative_styles"/>
            <t t-out="0"/>
        </div>
        <t t-call="general_template.creative_footer"/>
    </template>
    <template id="quotation_template_header">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <div class="header o_modern_duet" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;' ">
            <t t-call="general_template.creative_styles"/>
            <t t-set="card_text" t-value="'color: %s;' % (colors['primary_text'])"/>
            <div class="o_modern_duet_band o_modern_duet_hband">
                <table class="duh" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td class="dl">
                            <t t-if="o.company_id.invoice_logo">
                                <img class="lg" t-att-src="o.company_id._get_report_logo_uri(colors['primary'])" alt="Company Logo"/>
                            </t>
                            <div class="co">
                                <span t-field="o.company_id.name"/>
                                <br/>
                                <span t-out="o._get_street(o.company_id.partner_id)"/>
                                <br/>
                                <span t-out="o._get_address_details(o.company_id.partner_id)"/>
                            </div>
                        </td>
                        <td class="dc">
                            <div class="cardbox" t-attf-style="background-color: #{colors['primary']}; color: #{colors['primary_text']};">
                                <div class="cdt" t-att-style="card_text">Request for Quotation</div>
                                <div class="cno" t-att-style="card_text"><span t-field="o.name"/></div>
                                <table class="cgrid" border="0" cellpadding="0" cellspacing="0">
                                    <tr>
                                        <td t-if="o.date_order"> <div class="lbl"> <span t-if="o.state not in ['draft']">Date Ordered</span> <span t-if="o.state in ['draft']">Quotation Date</span> </div> <div class="fv"><span t-out="o.date_order"/></div> </td>
                                        <td t-if="o.partner_ref"> <div class="lbl">Your Order Reference</div> <div class="fv"><span t-field="o.partner_ref"/></div> </td>
                                        <td t-if="o.user_id"> <div class="lbl">Purchase Representative</div> <div class="fv"><span t-field="o.user_id"/></div> </td>
                                    </tr>
                                </table>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
            <t t-call="general_template.templates_watermark"/>
        </div>
    </template>
    <template id="report_quotation_main">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <t t-call="general_template.quotation_template_external_layout">
            <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
            <div class="page" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;'">
                <div class="oe_structure"/>
                <table class="parties" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td>
                            <p class="lbl">Vendor Address</p>
                            <t t-call="general_template.templates_customer_details"/>
                            <t t-call="general_template.creative_warehouse_details"/>
                        </td>
                        <td class="px">
                            <t t-if="o.company_id.name">
                                <p class="lbl">Pay to</p>
                                <t t-call="general_template.templates_company_details"/>
                            </t>
                        </td>
                    </tr>
                </table>
                <t t-call="general_template.creative_quotation_order_lines"/>
                <table class="fin" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td t-attf-style="color: #{colors['text']};"/>
                        <td class="fsig" t-attf-style="color: #{colors['text']};">
                            <t t-call="general_template.report_signature"/>
                            <t t-call="general_template.report_barcode"/>
                        </td>
                    </tr>
                </table>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>
    <!-- Bold-only copy of the line table; the shared one keeps the other designs. -->
    <template id="creative_quotation_order_lines">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <t t-set="rule_color" t-value="colors['primary']"/>
        <t t-set="th_style" t-value="'color: %s; border-bottom: 2px solid %s;' % (rule_color, rule_color)"/>
        <table class="lines">
            <thead>
                <tr>
                    <th t-att-style="th_style" class="r k-sr">Sr.</th>
                    <th t-att-style="th_style" class="l k-image" t-if="o.company_id.add_product_image == True">Image</th>
                    <th t-att-style="th_style" class="l k-product">Description</th>
                    <th t-att-style="th_style" class="c k-date">Expected Date</th>
                    <th t-att-style="th_style" class="r k-qty">Qty</th>
                </tr>
            </thead>
            <tbody>
                <t t-as="l" t-foreach="o.order_line">
                    <t t-if="l_odd">
                        <t t-set="ol_color" t-value="colors['even_party']"/>
                    </t>
                    <t t-if="l_even">
                        <t t-set="ol_color" t-value="colors['odd_party']"/>
                    </t>
                    <tr t-att-style="'background-color: %s; color: %s;' % (ol_color, colors['text'])">
                        <td class="r k-sr"><span t-out="l_index+1"/></td>
                        <td class="l k-image" t-if="o.company_id.add_product_image == True">
                            <img class="thumb" t-if="l.product_id and l.product_id.image_1920" t-att-src="image_data_uri(l.product_id.image_1920)"/>
                        </td>
                        <td class="l k-product">
                            <div class="pbody">
                                <div class="pname">
                                    <span t-if="l.product_id" t-out="l.product_id.display_name"/>
                                    <span t-else="" t-field="l.name" t-options="{'widget': 'text'}"/>
                                </div>
                                <div class="pd" t-if="o.company_id.is_description and l.product_id and l.name and l.name != l.product_id.display_name">
                                    <span t-field="l.name" t-options="{'widget': 'text'}"/>
                                </div>
                            </div>
                        </td>
                        <td class="c k-date"><span t-field="l.date_planned"/></td>
                        <td class="r k-qty">
                            <span t-field="l.product_qty"/>
                            <span groups="uom.group_uom" t-field="l.uom_id.name"/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>
    <template id="report_quotation_custom">
        <t t-call="web.html_container">
            <t t-as="o" t-foreach="docs">
                <t t-set="o" t-value="o.with_context(lang=lang)" />
                <t t-call="general_template.report_quotation_main" t-lang="lang"/>
            </t>
        </t>
    </template>

    <!-- Inherit rather than redefine purchase.report_purchasequotation: the core record keeps its own
         arch, so uninstalling this module restores the standard design
         instead of leaving an orphaned template behind. -->
    <template id="report_purchasequotation_dispatch" inherit_id="purchase.report_purchasequotation">
        <xpath expr="." position="replace">
            <t t-call="web.html_container">
                <t t-set="report_name" t-value="{'report_purchase_custom': 'general_template.report_quotation_main',                                         'report_purchase_custom_creative': 'general_template.report_quotation_creative_main',                                         'report_purchase_custom_elegant': 'general_template.report_quotation_elegant_main',                                         'report_purchase_custom_professional': 'general_template.report_quotation_professional_main',                                         'report_purchase_custom_exclusive': 'general_template.report_quotation_exclusive_main',                                         'report_purchase_custom_advanced': 'general_template.report_quotation_advanced_main',                 'report_purchase_custom_incredible': 'general_template.report_quotation_incredible_main',                 'report_purchase_custom_innovative': 'general_template.report_quotation_innovative_main',}"/>
                <t t-as="o" t-foreach="docs">
                    <t t-set="lang" t-value="o.partner_id.lang"/>
                    <t t-set="r_name" t-value="o.report_template_id and o.report_template_id.report_name or o.partner_id and o.partner_id.report_rfq_template_id and o.partner_id.report_rfq_template_id.report_name or o.company_id and o.company_id.report_rfq_template_id and o.company_id.report_rfq_template_id.report_name"/>
                    <!-- <t t-set="real_name" t-value="r_name.split('.')"/> -->
                    <t t-if="o.report_template_id or o.partner_id and o.partner_id.report_rfq_template_id or o.company_id and o.company_id.report_rfq_template_id">
                        <!-- <t t-call="#{report_name.get(real_name[1], 'general_template.report_quotation_advanced_main')}" t-lang="o.partner_id.lang"/>-->
                        <t t-call="general_template.report_quotation_main" t-if="r_name == 'general_template.report_purchase_custom'" t-lang="lang"/>
                        <t t-call="general_template.report_quotation_creative_main" t-if="r_name == 'general_template.report_purchase_custom_creative'" t-lang="lang"/>
                        <t t-call="general_template.report_quotation_elegant_main" t-if="r_name == 'general_template.report_purchase_custom_elegant'" t-lang="lang"/>
                        <t t-call="general_template.report_quotation_professional_main" t-if="r_name == 'general_template.report_purchase_custom_professional'" t-lang="lang"/>
                        <t t-call="general_template.report_quotation_exclusive_main" t-if="r_name == 'general_template.report_purchase_custom_exclusive'" t-lang="lang"/>
                        <t t-call="general_template.report_quotation_advanced_main" t-if="r_name == 'general_template.report_purchase_custom_advanced'" t-lang="lang"/>
                        <t t-call="general_template.report_quotation_incredible_main" t-if="r_name == 'general_template.report_purchase_custom_incredible'" t-lang="lang"/>
                        <t t-call="general_template.report_quotation_innovative_main" t-if="r_name == 'general_template.report_purchase_custom_innovative'" t-lang="lang"/>
                    </t>
                    <t t-else=''>
                        <t t-call="purchase.report_purchasequotation_document" t-lang="lang"/>
                    </t>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
