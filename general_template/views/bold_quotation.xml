<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="quotation_elegant_external_layout">
        <!-- Multicompany -->
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>
        <t t-call="general_template.quotation_elegant_header"/>
        <div class="article o_report_layout_standard o_bold_remit" t-att-data-oe-id="o and o.id" t-att-data-oe-model="o and o._name" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="general_template.elegant_styles"/>
            <t t-out="0"/>
        </div>
        <t t-call="general_template.elegant_footer"/>
    </template>
    <template id="quotation_elegant_header">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <div class="header o_bold_remit" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;' ">
            <t t-call="general_template.elegant_styles"/>
            <div class="o_bold_remit_band o_bold_remit_hband">
                <table class="re-hd" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td class="hlogo">
                            <t t-if="o.company_id.invoice_logo">
                                <img class="lg" t-att-src="o.company_id._get_report_logo_uri(colors['primary'])" alt="Company Logo"/>
                            </t>
                        </td>
                        <td>
                            <div class="dt">Request for Quotation</div>
                            <div class="no">
                                <span t-field="o.name"/>
                            </div>
                        </td>
                    </tr>
                </table>
                <table class="re-facts">
                    <tr>
                        <td t-if="o.date_order">
                            <div class="lbl">
                                <span t-if="o.state not in ['draft']">Date Ordered</span>
                                <span t-if="o.state in ['draft']">Quotation Date</span>
                            </div>
                            <div class="fv"><span t-out="o.date_order"/></div>
                        </td>
                        <td t-if="o.partner_ref">
                            <div class="lbl">Your Order Reference</div>
                            <div class="fv"><span t-field="o.partner_ref"/></div>
                        </td>
                        <td t-if="o.user_id">
                            <div class="lbl">Purchase Representative</div>
                            <div class="fv"><span t-field="o.user_id"/></div>
                        </td>
                    </tr>
                </table>
            </div>
            <t t-call="general_template.templates_watermark"/>
        </div>
    </template>
    <template id="report_quotation_elegant_main">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <t t-call="general_template.quotation_elegant_external_layout">
            <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
            <div class="page" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;'">
                <div class="oe_structure"/>
                <table class="parties" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td>
                            <p class="lbl" t-attf-style="background-color: #{colors['primary']}; color: #{colors['primary_text']};">Vendor Address</p>
                            <t t-call="general_template.templates_customer_details"/>
                            <t t-call="general_template.elegant_warehouse_details"/>
                        </td>
                        <td class="px">
                            <t t-if="o.company_id.name">
                                <p class="lbl" t-attf-style="background-color: #{colors['primary']}; color: #{colors['primary_text']};">Pay to</p>
                                <t t-call="general_template.templates_company_details"/>
                            </t>
                        </td>
                    </tr>
                </table>
                <t t-call="general_template.elegant_quotation_order_lines"/>
                <table class="fin" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td t-attf-style="color: #{colors['text']};"/>
                        <td class="fsig" t-attf-style="color: #{colors['text']};">
                            <t t-call="general_template.report_signature"/>
                            <t t-call="general_template.report_barcode"/>
                        </td>
                    </tr>
                </table>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>
    <!-- Bold-only copy of the line table; the shared one keeps the other designs. -->
    <template id="elegant_quotation_order_lines">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <table class="lines">
            <thead>
                <tr t-attf-style="background-color: #{colors['primary']}; color: #{colors['primary_text']};">
                    <th class="r k-sr">Sr.</th>
                    <th class="l k-image" t-if="o.company_id.add_product_image == True">Image</th>
                    <th class="l k-product">Description</th>
                    <th class="c k-date">Expected Date</th>
                    <th class="r k-qty">Qty</th>
                </tr>
            </thead>
            <tbody>
                <t t-as="l" t-foreach="o.order_line">
                    <t t-if="l_odd">
                        <t t-set="ol_color" t-value="colors['even_party']"/>
                    </t>
                    <t t-if="l_even">
                        <t t-set="ol_color" t-value="colors['odd_party']"/>
                    </t>
                    <tr t-att-style="'background-color: %s; color: %s;' % (ol_color, colors['text'])">
                        <td class="r k-sr"><span t-out="l_index+1"/></td>
                        <td class="l k-image" t-if="o.company_id.add_product_image == True">
                            <img class="thumb" t-if="l.product_id and l.product_id.image_1920" t-att-src="image_data_uri(l.product_id.image_1920)"/>
                        </td>
                        <td class="l k-product">
                            <div class="pbody">
                                <div class="pname">
                                    <span t-if="l.product_id" t-out="l.product_id.display_name"/>
                                    <span t-else="" t-field="l.name" t-options="{'widget': 'text'}"/>
                                </div>
                                <div class="pd" t-if="o.company_id.is_description and l.product_id and l.name and l.name != l.product_id.display_name">
                                    <span t-field="l.name" t-options="{'widget': 'text'}"/>
                                </div>
                            </div>
                        </td>
                        <td class="c k-date"><span t-field="l.date_planned"/></td>
                        <td class="r k-qty">
                            <span t-field="l.product_qty"/>
                            <span groups="uom.group_uom" t-field="l.uom_id.name"/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>
    <template id="report_quotation_custom_elegant">
        <t t-call="web.html_container">
            <t t-as="o" t-foreach="docs">
                <t t-set="o" t-value="o.with_context(lang=lang)" />
                <t t-call="general_template.report_quotation_elegant_main" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>
