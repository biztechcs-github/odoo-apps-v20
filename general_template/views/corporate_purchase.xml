<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="purchase_exclusive_external_layout">
        <!-- Multicompany -->
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>
        <t t-call="general_template.purchase_exclusive_header"/>
        <div class="article o_report_layout_standard o_corp_bp" t-att-data-oe-id="o and o.id" t-att-data-oe-model="o and o._name" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="general_template.exclusive_styles"/>
            <t t-out="0"/>
        </div>
        <t t-call="general_template.exclusive_footer"/>
    </template>
    <template id="purchase_exclusive_header">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <div class="header o_corp_bp" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;' ">
            <t t-call="general_template.exclusive_styles"/>
            <div class="o_corp_bp_band o_corp_bp_hband">
                <table class="tbh" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td class="lgc" rowspan="2"><t t-if="o.company_id.invoice_logo">
                                <img class="lg" t-att-src="o.company_id._get_report_logo_uri(colors['primary'])" alt="Company Logo"/>
                            </t></td>
                        <td class="id" rowspan="2">
                            <div class="dt"><span t-if="o.state not in ['draft']">Purchase Order Confirmation</span>
                                <span t-if="o.state in ['draft']">Request for Quotation</span></div>
                            <div class="tbno"><span t-field="o.name"/></div>
                        </td>
                        <td t-if="o.date_order"> <div class="lbl"> <span t-if="o.state not in ['draft']">Date Ordered</span> <span t-if="o.state in ['draft']">Quotation Date</span> </div> <div class="fv"><span t-out="o.date_order"/></div> </td>
                        <td t-if="o.partner_ref"> <div class="lbl">Your Order Reference</div> <div class="fv"><span t-field="o.partner_ref"/></div> </td>
                        <td t-if="o.user_id"> <div class="lbl">Purchase Representative</div> <div class="fv"><span t-field="o.user_id"/></div> </td>
                    </tr>
                    <tr>
                        <td> <div class="lbl">Total</div> <div class="fv" style="font-weight:700; font-size:14px;"><span t-field="o.amount_total"/></div> </td>
                    </tr>
                </table>
                <div class="bpco">
                    <span t-field="o.company_id.name"/>
                    &#183;
                    <span t-out="o._get_street(o.company_id.partner_id)"/>
                    &#183;
                    <span t-out="o._get_address_details(o.company_id.partner_id)"/>
                </div>
            </div>
            <t t-call="general_template.templates_watermark"/>
        </div>
    </template>
    <template id="report_purchase_exclusive_main">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <t t-call="general_template.purchase_exclusive_external_layout">
            <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
            <div class="page" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;'">
                <div class="oe_structure"/>
                <table class="parties" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td>
                            <p class="lbl" t-attf-style="color: #{colors['primary']};">Vendor Address</p>
                            <t t-call="general_template.templates_customer_details"/>
                            <t t-call="general_template.exclusive_warehouse_details"/>
                        </td>
                        <td class="px">
                            <t t-if="o.company_id.name">
                                <p class="lbl" t-attf-style="color: #{colors['primary']};">Pay to</p>
                                <t t-call="general_template.templates_company_details"/>
                            </t>
                        </td>
                    </tr>
                </table>
                <t t-call="general_template.exclusive_purchase_order_lines"/>
                <table class="bside" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td class="bl" t-attf-style="color: #{colors['text']};">
                            <!-- purchase.order has no notes field; the original template
                                 kept this block commented out for the same reason. -->
                        </td>
                        <td class="br">
                            <t t-call="general_template.exclusive_purchase_totals"/>
                        </td>
                    </tr>
                </table>
                <div class="wline" t-attf-style="color: #{colors['text']};">
                    <t t-call="general_template.template_total_amount_word"/>
                </div>
                <table class="fin" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td t-attf-style="color: #{colors['text']};"/>
                        <td class="fsig" t-attf-style="color: #{colors['text']};">
                            <t t-call="general_template.report_signature"/>
                            <t t-call="general_template.report_barcode"/>
                        </td>
                    </tr>
                </table>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>
    <!-- Corporate-only copies of the blocks whose look the design changes. -->
    <template id="exclusive_purchase_order_lines">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <t t-set="th_style" t-value="'color: %s;' % (colors['primary'])"/>
        <table class="lines">
            <thead>
                <tr>
                    <th t-att-style="th_style" class="r k-sr">Sr.</th>
                    <th t-att-style="th_style" class="l k-image" t-if="o.company_id.add_product_image == True">Image</th>
                    <th t-att-style="th_style" class="l k-product">Description</th>
                    <th t-att-style="th_style" class="c k-tax">Taxes</th>
                    <th t-att-style="th_style" class="c k-date">Date Req.</th>
                    <th t-att-style="th_style" class="r k-qty">Qty</th>
                    <th t-att-style="th_style" class="r k-price">Unit Price</th>
                    <th t-att-style="th_style" class="r k-amount">Net Price</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="line_span" t-value="7 if o.company_id.add_product_image == True else 6"/>
                <t t-as="l" t-foreach="o.order_line">
                    <t t-if="l_odd">
                        <t t-set="ol_color" t-value="colors['even_party']"/>
                    </t>
                    <t t-if="l_even">
                        <t t-set="ol_color" t-value="colors['odd_party']"/>
                    </t>
                    <tr t-att-class="'sec' if l.display_type == 'line_section' else ('note' if l.display_type == 'line_note' else '')" t-att-style="'background-color: %s; color: %s;' % (ol_color, colors['text'])">
                        <t t-if="not l.display_type">
                            <td class="r k-sr"><span t-out="l_index+1"/></td>
                            <td class="l k-image" t-if="o.company_id.add_product_image == True">
                                <img class="thumb" t-if="l.product_id and l.product_id.image_1920" t-att-src="image_data_uri(l.product_id.image_1920)"/>
                            </td>
                            <td class="l k-product">
                                <div class="pbody">
                                    <div class="pname">
                                        <span t-if="l.product_id" t-out="l.product_id.display_name"/>
                                        <span t-else="" t-field="l.name" t-options="{'widget': 'text'}"/>
                                    </div>
                                    <div class="pd" t-if="o.company_id.is_description and l.product_id and l.name and l.name != l.product_id.display_name">
                                        <span t-field="l.name" t-options="{'widget': 'text'}"/>
                                    </div>
                                </div>
                            </td>
                            <td class="c k-tax">
                                <span t-out="', '.join(map(lambda x: x.name, l.tax_ids))"/>
                            </td>
                            <td class="c k-date"><span t-field="l.date_planned"/></td>
                            <td class="r k-qty">
                                <span t-field="l.product_qty"/>
                                <span groups="uom.group_uom" t-field="l.uom_id.name"/>
                            </td>
                            <td class="r k-price"><span t-field="l.price_unit"/></td>
                            <td class="r k-amount">
                                <span t-field="l.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                            </td>
                        </t>
                        <t t-if="l.display_type == 'line_section'">
                            <td class="r k-sr"><span t-out="l_index+1"/></td>
                            <td t-att-colspan="line_span" id="section">
                                <span t-field="l.name" t-options="{'widget': 'text'}"/>
                            </td>
                            <t t-set="current_section" t-value="l"/>
                            <t t-set="current_subtotal" t-value="0"/>
                        </t>
                        <t t-if="l.display_type == 'line_note'">
                            <td class="r k-sr"><span t-out="l_index+1"/></td>
                            <td t-att-colspan="line_span">
                                <span t-field="l.name" t-options="{'widget': 'text'}"/>
                            </td>
                        </t>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>
    <template id="exclusive_purchase_totals">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <table class="tot">
            <tr>
                <td>SubTotal</td>
                <td class="r">
                    <span t-field="o.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                </td>
            </tr>
            <tr>
                <td>Taxes</td>
                <td class="r">
                    <span t-field="o.amount_tax" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                </td>
            </tr>
            <tr class="tm_gray_bg" t-attf-style="color: #{colors['primary_text']}; background-color: #{colors['primary']};">
                <td><strong>Total</strong></td>
                <td class="r">
                    <span t-field="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                </td>
            </tr>
        </table>
    </template>
    <template id="report_purchase_custom_exclusive">
        <t t-call="web.html_container">
            <t t-as="o" t-foreach="docs">
                <t t-set="o" t-value="o.with_context(lang=lang)" />
                <t t-call="general_template.report_purchase_exclusive_main" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>
