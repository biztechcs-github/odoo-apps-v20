<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_delivery_advance_layout">
        <!-- Multicompany -->
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>
        <t t-call="general_template.delivery_advanced_header"/>
        <div class="article o_report_layout_standard o_polished_route" t-att-data-oe-id="o and o.id" t-att-data-oe-model="o and o._name" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="general_template.advanced_styles"/>
            <t t-out="0"/>
        </div>
        <t t-call="general_template.advanced_footer"/>
    </template>
    <template id="delivery_advanced_header">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <div class="header o_polished_route" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;' ">
            <t t-call="general_template.advanced_styles"/>
            <t t-set="rule_color" t-value="colors['primary']"/>
            <div class="o_polished_route_band o_polished_route_hband">
                <table class="roh" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td><t t-if="o.company_id.invoice_logo">
                                <img class="lg" t-att-src="o.company_id._get_report_logo_uri(colors['primary'])" alt="Company Logo"/>
                            </t></td>
                        <td class="rc">
                            <span t-field="o.company_id.name"/>
                            <br/>
                            <span t-out="o._get_street(o.company_id.partner_id)"/>
                            <br/>
                            <span t-out="o._get_address_details(o.company_id.partner_id)"/>
                        </td>
                    </tr>
                </table>
                <table class="pass2" t-attf-style="border: 1.5px solid #{rule_color};">
                    <tr>
                        <td class="pid" t-attf-style="border-right: 1px dashed #{rule_color};">
                            <div class="dt">Delivery Note</div>
                            <div class="no" t-att-style="'color: %s;' % rule_color"><span t-field="o.name"/></div>
                        </td>
                        <td class="pf" t-if="o.origin"> <div class="lbl">Order (Origin)</div> <div class="fv"><span t-field="o.origin"/></div> </td>
                        <td class="pf" t-if="o.scheduled_date"> <div class="lbl">Scheduled Date</div> <div class="fv"><span t-field="o.scheduled_date"/></div> </td>
                        <td class="pf" t-if="o.carrier_id"> <div class="lbl">Carrier</div> <div class="fv"><span t-field="o.carrier_id"/></div> </td>
                        <td class="pf" t-if="o.shipping_weight"> <div class="lbl">Total Weight</div> <div class="fv"> <span t-field="o.shipping_weight"/> <span t-field="o.weight_uom_name"/> </div> </td>
                        <td class="pf" t-if="o.sudo().sale_id.client_order_ref"> <div class="lbl">Customer Reference</div> <div class="fv"><span t-field="o.sudo().sale_id.client_order_ref"/></div> </td>
                    </tr>
                </table>
            </div>
            <t t-call="general_template.templates_watermark"/>
        </div>
    </template>
    <template id="report_delivery_advanced_main">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <t t-call="general_template.template_delivery_advance_layout">
            <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
            <div class="page" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;'">
                <div class="oe_structure"/>
                <table class="parties" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td name="div_outgoing_address">
                            <t t-call="general_template.advanced_picking_addresses"/>
                        </td>
                        <td class="px">
                            <t t-if="o.company_id.name">
                                <p class="lbl">Pay to</p>
                                <t t-call="general_template.templates_company_details"/>
                            </t>
                        </td>
                    </tr>
                </table>
                <t t-call="general_template.advanced_delivery_order_lines"/>
                <table class="fin" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td t-attf-style="color: #{colors['text']};"/>
                        <td class="fsig" t-attf-style="color: #{colors['text']};">
                            <span t-field="o.name" t-options="{'widget':'barcode','width':190,'height':35}"/>
                        </td>
                    </tr>
                </table>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>
    <!-- Polished-only copies of the blocks whose look the design changes. -->
    <template id="advanced_delivery_order_lines">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <table class="lines" t-if="not o.move_line_ids">
            <thead>
                <tr>
                    <th t-att-style="th_style" class="r k-sr">Sr.</th>
                    <th t-att-style="th_style" class="l k-product">Product</th>
                    <th t-att-style="th_style" class="c k-state">Status</th>
                    <th t-att-style="th_style" class="c k-loc">Location</th>
                    <th t-att-style="th_style" class="r k-ordered">Ordered</th>
                    <th t-att-style="th_style" class="r k-delivered">Delivered</th>
                </tr>
            </thead>
            <tbody>
                <t t-as="move" t-foreach="o.move_ids">
                    <t t-if="move_odd">
                        <t t-set="mv_color" t-value="colors['even_party']"/>
                    </t>
                    <t t-if="move_even">
                        <t t-set="mv_color" t-value="colors['odd_party']"/>
                    </t>
                    <tr t-att-style="'background-color: %s; color: %s;' % (mv_color, colors['text'])">
                        <td class="r k-sr"><span t-out="move_index+1"/></td>
                        <td class="l k-product">
                            <div class="pbody">
                                <span t-field="move.product_id"/>
                                <div class="pd" t-if="move.description_picking != move.product_id.name and move.description_picking != move.product_id.display_name">
                                    <span t-field="move.description_picking"/>
                                </div>
                            </div>
                        </td>
                        <td class="c k-state"><span t-field="move.state"/></td>
                        <td class="c k-loc"><span t-field="move.location_id"/></td>
                        <td class="r k-ordered">
                            <span t-field="move.product_uom_qty"/>
                            <span t-field="move.uom_id"/>
                        </td>
                        <td class="r k-delivered">
                            <span t-field="move.quantity"/>
                            <span t-field="move.uom_id"/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>
        <table class="lines" t-if="o.move_line_ids">
            <t groups="stock.group_lot_on_delivery_slip" t-set="has_serial_number" t-value="o.move_line_ids.mapped('lot_id')"/>
            <thead>
                <tr>
                    <th t-att-style="th_style" class="r k-sr">Sr.</th>
                    <th t-att-style="th_style" class="l k-image" t-if="o.company_id.add_product_image == True">Image</th>
                    <th t-att-style="th_style" class="l k-product">Product</th>
                    <th t-att-style="th_style" class="l k-lot" t-if="has_serial_number">Serial Number</th>
                    <th t-att-style="th_style" class="c k-state">Status</th>
                    <th t-att-style="th_style" class="c k-loc">Location</th>
                    <th t-att-style="th_style" class="r k-ordered">Ordered</th>
                    <th t-att-style="th_style" class="r k-delivered">Delivered</th>
                </tr>
            </thead>
            <tbody>
                <t t-as="pack_operation" t-foreach="o.move_ids">
                    <t t-if="pack_operation_odd">
                        <t t-set="po_color" t-value="colors['even_party']"/>
                    </t>
                    <t t-if="pack_operation_even">
                        <t t-set="po_color" t-value="colors['odd_party']"/>
                    </t>
                    <tr t-att-style="'background-color: %s; color: %s;' % (po_color, colors['text'])">
                        <td class="r k-sr"><span t-out="pack_operation_index+1"/></td>
                        <td class="l k-image" t-if="o.company_id.add_product_image == True">
                            <t t-set="prod" t-value="pack_operation.product_id"/>
                            <img class="thumb" t-if="prod and prod.image_1920" t-att-src="image_data_uri(prod.image_1920)"/>
                        </td>
                        <td class="l k-product">
                            <div class="pbody">
                                <span t-field="pack_operation.product_id"/>
                                <div class="pd" t-if="pack_operation.description_picking != pack_operation.product_id.name and pack_operation.description_picking != pack_operation.product_id.display_name">
                                    <span t-field="pack_operation.description_picking"/>
                                </div>
                            </div>
                        </td>
                        <t t-if="has_serial_number">
                            <td class="l k-lot">
                                <table class="lots">
                                    <thead>
                                        <tr>
                                            <th t-att-style="th_style">Lot</th>
                                            <th t-att-style="th_style">Qty</th>
                                        </tr>
                                    </thead>
                                    <tr t-foreach="pack_operation.lot_ids" t-as='lot_id'>
                                        <td>
                                            <span t-out="lot_id.name"/>
                                            <t t-if="not lot_id">
                                                <span t-field="lot_id.name"/>
                                            </t>
                                        </td>
                                        <td>
                                            <t t-if="lot_id.product_qty">
                                                <span t-out="lot_id.product_qty"/>
                                            </t>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                            <td t-if="not has_serial_number"/>
                        </t>
                        <td class="c k-state">
                            <t t-set="mls" t-value="pack_operation.picking_id.move_ids"/>
                            <t t-set="check" t-value="True"/>
                            <t t-as="ml" t-foreach="mls">
                                <t t-if="ml.product_id.id == pack_operation.product_id.id and check">
                                    <t t-set="check" t-value="False"/>
                                    <span t-field="ml.state"/>
                                </t>
                            </t>
                        </td>
                        <td class="c k-loc"><span t-field="pack_operation.location_id"/></td>
                        <td class="r k-ordered">
                            <span t-field="pack_operation.product_uom_qty"/>
                            <span t-field="pack_operation.uom_id"/>
                        </td>
                        <td class="r k-delivered">
                            <span t-field="pack_operation.quantity"/>
                            <span t-field="pack_operation.uom_id"/>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>
    <template id="report_delivery_custom_advanced">
        <t t-call="web.html_container">
            <t t-as="o" t-foreach="docs">
                <t t-set="o" t-value="o.with_context(lang=lang)" />
                <t t-call="general_template.report_delivery_advanced_main" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>
