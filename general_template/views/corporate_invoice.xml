<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="exclusive_external_layout">
        <!-- Multicompany -->
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>
        <t t-call="general_template.exclusive_header"/>
        <div class="article o_report_layout_standard o_corp_bp" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="general_template.exclusive_styles"/>
            <t t-out="0"/>
        </div>
        <t t-call="general_template.exclusive_footer"/>
    </template>
    <template id="exclusive_header">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <div class="header o_corp_bp" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;' ">
            <t t-call="general_template.exclusive_styles"/>
            <div class="o_corp_bp_band o_corp_bp_hband">
                <table class="tbh" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td class="lgc" rowspan="2"><t t-if="o.company_id.invoice_logo">
                                <img class="lg" t-att-src="o.company_id._get_report_logo_uri(colors['primary'])" alt="Company Logo"/>
                            </t></td>
                        <td class="id" rowspan="2">
                            <div class="dt"><span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>
                                <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                                <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                                <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                                <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                                <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span></div>
                            <div class="tbno"><span t-field="o.name"/></div>
                        </td>
                        <td t-if="o._get_invoice_date()"> <div class="lbl">Invoice Date</div> <div class="fv"><span t-out="o._get_invoice_date()"/></div> </td>
                        <td t-if="o._get_invoice_due_date()"> <div class="lbl">Due Date</div> <div class="fv"><span t-out="o._get_invoice_due_date()"/></div> </td>
                        <td t-if="o.ref"> <div class="lbl">Reference</div> <div class="fv"><span t-out="o.ref"/></div> </td>
                    </tr>
                    <tr>
                        <td t-if="o.invoice_origin"> <div class="lbl"> <span t-if="o.move_type in ('out_invoice','out_refund')">Sales Order</span> <span t-if="o.move_type in ('in_invoice','in_refund')">Purchase Order</span> </div> <div class="fv"><span t-field="o.invoice_origin"/></div> </td>
                        <td t-if="o._get_origin_date(o.invoice_origin)"> <div class="lbl">Order Date</div> <div class="fv"><span t-out="o._get_origin_date(o.invoice_origin)"/></div> </td>
                        <td t-if="o.partner_id.ref"> <div class="lbl">Customer Code</div> <div class="fv"><span t-out="o.partner_id.ref"/></div> </td>
                    </tr>
                    <tr>
                        <td> <div class="lbl">Grand Total</div> <div class="fv" style="font-weight:700; font-size:14px;"><span t-field="o.amount_total"/></div> </td>
                    </tr>
                </table>
                <div class="bpco">
                    <span t-field="o.company_id.name"/>
                    &#183;
                    <span t-out="o._get_street(o.company_id.partner_id)"/>
                    &#183;
                    <span t-out="o._get_address_details(o.company_id.partner_id)"/>
                </div>
            </div>
            <t t-call="general_template.template_watermark"/>
        </div>
    </template>
    <template id="report_invoice_exclusive_main">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <t t-call="general_template.exclusive_external_layout">
            <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
            <div class="page" t-att-style="'font-family:'+o.company_id.font_id.family+';font-size:'+str(o.company_id.font_size)+'px;'">
                <div class="oe_structure"/>
                <table class="parties" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td>
                            <t t-call="general_template.exclusive_customer_details"/>
                        </td>
                        <td class="px">
                            <t t-if="o.company_id.name">
                                <p class="lbl" t-attf-style="color: #{colors['primary']};">Pay to</p>
                                <t t-call="general_template.templates_company_details"/>
                            </t>
                        </td>
                    </tr>
                </table>
                <t t-call="general_template.exclusive_invoice_order_lines"/>
                <table class="bside" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td class="bl" t-attf-style="color: #{colors['text']};">
                            <t t-call="general_template.report_invoice_notes"/>
                            <div class="wline" t-if="o.payment_state">
                                <span class="lbl">Payment Status:</span>
                                <span class="pill" t-out="dict(o._fields['payment_state']._description_selection(o.env)).get(o.payment_state)"/>
                            </div>
                        </td>
                        <td class="br">
                            <t t-call="general_template.exclusive_invoice_totals"/>
                        </td>
                    </tr>
                </table>
                <div class="wline" t-attf-style="color: #{colors['text']};">
                    <t t-call="general_template.template_total_amount_word"/>
                </div>
                <table class="fin" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td t-attf-style="color: #{colors['text']};"/>
                        <td class="fsig">
                            <t t-call="general_template.report_invoice_signature"/>
                            <t t-call="general_template.report_invoice_barcode"/>
                        </td>
                    </tr>
                </table>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>
    <!-- Corporate-only copies of the shared blocks whose look the design changes.
         The shared general_template.* versions stay untouched so Classic,
         Vintage, Morden, Polished and Corporate are unaffected. -->
    <template id="exclusive_customer_details">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <p class="lbl" t-attf-style="color: #{colors['primary']};">
            <span t-if="o.partner_shipping_id == o.partner_id">Invoicing and Shipping Address</span>
            <span t-if="o.partner_shipping_id != o.partner_id">Invoicing Address</span>
        </p>
        <t t-if="o.partner_id">
            <p t-attf-style="color: #{colors['customer']};">
                <t t-if="o.company_id and o.company_id.is_customer_bold">
                    <strong><span t-field="o.partner_id"/></strong>
                </t>
                <t t-if="not o.company_id.is_customer_bold">
                    <span t-field="o.partner_id"/>
                </t>
            </p>
            <p t-attf-style="color: #{colors['customer_address']};">
                <span t-out="o._get_street(o.partner_id)"/>
                <br/>
                <span t-out="o._get_address_details(o.partner_id)"/>
                <t t-if="o.partner_id.phone">
                    <br/>
                    <span t-field="o.partner_id.phone"/>
                </t>
                <t t-if="o.partner_id.email">
                    <br/>
                    <span t-field="o.partner_id.email"/>
                </t>
                <t t-if="o.partner_id.vat">
                    <br/>
                    <strong>Vat: </strong>
                    <span t-field="o.partner_id.vat"/>
                </t>
            </p>
        </t>
        <t t-if="o.partner_shipping_id and o.partner_shipping_id != o.partner_id">
            <p class="lbl" t-attf-style="color: #{colors['primary']};">Shipping Address</p>
            <p t-attf-style="color: #{colors['customer']};">
                <t t-if="o.company_id and o.company_id.is_customer_bold">
                    <strong><span t-field="o.partner_shipping_id"/></strong>
                </t>
                <t t-if="not o.company_id.is_customer_bold">
                    <span t-field="o.partner_shipping_id"/>
                </t>
            </p>
            <p t-attf-style="color: #{colors['customer_address']};">
                <span t-out="o._get_street(o.partner_shipping_id)"/>
                <br/>
                <span t-out="o._get_address_details(o.partner_shipping_id)"/>
                <t t-if="o.partner_shipping_id.phone">
                    <br/>
                    <span t-field="o.partner_shipping_id.phone"/>
                </t>
            </p>
        </t>
    </template>
    <template id="exclusive_invoice_order_lines">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <t t-set="display_discount" t-value="any([l.discount for l in o.invoice_line_ids])"/>
        <t t-set="th_style" t-value="'color: %s;' % (colors['primary'])"/>
        <table class="lines">
            <thead>
                <tr>
                    <th t-att-style="th_style" class="r k-sr">Sr.</th>
                    <th t-att-style="th_style" class="l k-image" t-if="o.company_id.add_product_image == True">Image</th>
                    <th t-att-style="th_style" class="l k-product">Description</th>
                    <th t-att-style="th_style" class="r k-qty">Quantity</th>
                    <th t-att-style="th_style" class="r k-price">Unit Price</th>
                    <th t-att-style="th_style" class="r k-disc" groups="product.group_discount_per_so_line" t-if="display_discount">Disc.%</th>
                    <th t-att-style="th_style" class="r k-tax">Taxes</th>
                    <th t-att-style="th_style" class="r k-amount">Amount</th>
                </tr>
            </thead>
            <tbody>
                <t t-set="line_span" t-value="6 if o.company_id.add_product_image == True else 5"/>
                <t t-set="line_span" t-value="line_span + 1 if display_discount else line_span"/>
                <t t-as="l" t-foreach="o.invoice_line_ids">
                    <t t-if="l_odd">
                        <t t-set="ol_color" t-value="colors['even_party']"/>
                    </t>
                    <t t-if="l_even">
                        <t t-set="ol_color" t-value="colors['odd_party']"/>
                    </t>
                    <tr t-att-class="'sec' if l.display_type == 'line_section' else ('note' if l.display_type == 'line_note' else '')" t-att-style="'color: %s; background-color: %s;' % (colors['text'], ol_color)">
                        <t t-if="l.display_type == 'product'">
                            <td class="r k-sr"><span t-out="l_index+1"/></td>
                            <td class="l k-image" t-if="o.company_id.add_product_image == True">
                                <img class="thumb" t-if="l.product_id and l.product_id.image_1920" t-att-src="image_data_uri(l.product_id.image_1920)"/>
                            </td>
                            <td class="l k-product">
                                <div class="pbody">
                                    <div class="pname">
                                        <span t-if="l.product_id" t-out="l.product_id.display_name"/>
                                        <span t-else="" t-field="l.name" t-options="{'widget': 'text'}"/>
                                    </div>
                                    <div class="pd" t-if="o.company_id.is_description and l.product_id and l.name and l.name != l.product_id.display_name">
                                        <span t-field="l.name" t-options="{'widget': 'text'}"/>
                                    </div>
                                </div>
                            </td>
                            <td class="r k-qty"><span t-field="l.quantity"/></td>
                            <td class="r k-price">
                                <span t-field="l.price_unit" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                            </td>
                            <td class="r k-disc" groups="product.group_discount_per_so_line" t-if="display_discount">
                                <span t-field="l.discount"/>
                            </td>
                            <td class="r k-tax">
                                <span t-out="', '.join(map(lambda x: (x.description or x.name), l.tax_ids))"/>
                            </td>
                            <td class="r k-amount">
                                <span t-field="l.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                            </td>
                        </t>
                        <t t-if="l.display_type == 'line_section'">
                            <td class="r k-sr"><span t-out="l_index+1"/></td>
                            <td t-att-colspan="line_span">
                                <span t-field="l.name" t-options="{'widget': 'text'}"/>
                            </td>
                            <t t-set="current_section" t-value="l"/>
                            <t t-set="current_subtotal" t-value="0"/>
                        </t>
                        <t t-if="l.display_type == 'line_note'">
                            <td class="r k-sr"><span t-out="l_index+1"/></td>
                            <td t-att-colspan="line_span">
                                <span t-field="l.name" t-options="{'widget': 'text'}"/>
                            </td>
                        </t>
                    </tr>
                </t>
            </tbody>
        </table>
    </template>
    <template id="exclusive_invoice_totals">
        <t t-set="colors" t-value="o.company_id._get_report_colors()"/>
        <table class="tot">
            <t t-set="tax_totals" t-value="o.tax_totals"/>
            <t t-call="general_template.document_tax_totals_custom"/>
            <t t-if="print_with_payments">
                <t t-if="o.payment_state != 'invoicing_legacy'">
                    <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                    <t t-foreach="payments_vals" t-as="payment_vals">
                        <tr t-if="payment_vals['is_exchange'] == 0">
                            <td>
                                <i class="oe_form_field oe_payment_label">Paid on <t t-out="payment_vals['date']" t-options='{"widget": "date"}'/></i>
                            </td>
                            <td class="r">
                                <span t-out="payment_vals['amount']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </t>
                    <tr class="o_due" t-attf-style="color: #{colors['primary_text']}; background-color: #{colors['primary']};" t-if="len(payments_vals) &gt; 0">
                        <td><strong>Amount Due</strong></td>
                        <td class="r">
                            <span t-field="o.amount_residual"/>
                        </td>
                    </tr>
                </t>
            </t>
        </table>
    </template>
    <template id="report_invoice_template_custom_exclusive">
        <t t-call="web.html_container">
            <t t-as="o" t-foreach="docs">
                <t t-set="o" t-value="o.with_context(lang=lang)" />
                <t t-call="general_template.report_invoice_exclusive_main" t-lang="lang"/>
            </t>
        </t>
    </template>
    <template id="report_invoice_exclusive_main_duplicate" inherit_id="general_template.report_invoice_exclusive_main" primary="True">
        <!-- <xpath expr="//div[@t-if='not o._compute_payments_widget_reconciled_info()']" position="before">
            <t t-call="general_template.report_invoice_payment_move_line"/>
        </xpath> -->
    </template>
</odoo>
